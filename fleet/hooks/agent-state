#!/bin/sh
# Claude Code hook for the events that only change a seat's state, busy and
# waiting, which run on every tool call: a tmux call is quicker than starting
# fleet. `fleet signal` covers the same states for other callers.

[ -n "$TMUX_PANE" ] || exit 0
# settings rendered by an older `fleet new` run `agent-state clear` at SessionEnd
[ "$1" = clear ] && exec "$(dirname "$0")/session-end"

tmux set -p -t "$TMUX_PANE" @agent_state "$1"
