#!/bin/sh
# Claude Code hook: sets @agent_state on the session's tmux pane, which the
# pane-border-format in tmux.conf displays. "clear" unsets it.

[ -n "$TMUX_PANE" ] || exit 0

if [ "$1" = clear ]; then
  tmux set -p -u -t "$TMUX_PANE" @agent_state
else
  tmux set -p -t "$TMUX_PANE" @agent_state "$1"
fi
