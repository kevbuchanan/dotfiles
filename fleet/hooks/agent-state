#!/bin/sh
# Claude Code hook: sets @agent_state on the session's tmux pane, which the
# pane-border-format in tmux.conf displays.

[ -n "$TMUX_PANE" ] || exit 0
# settings rendered by an older `fleet new` run `agent-state clear` at SessionEnd
[ "$1" = clear ] && exec "$(dirname "$0")/session-end"

tmux set -p -t "$TMUX_PANE" @agent_state "$1"
