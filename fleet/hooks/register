#!/bin/sh
# Claude Code SessionStart hook: tells fleet the session in this pane started,
# with the inbox socket Claude Code exports to hooks as
# CLAUDE_CODE_MESSAGING_SOCKET, where fleet delivers task messages. It runs
# again after /clear and on restart, so the record follows the session.

[ -n "$TMUX_PANE" ] || exit 0
cat > /dev/null
exec "$(dirname "$0")/../bin/fleet" signal start --socket "$CLAUDE_CODE_MESSAGING_SOCKET"
