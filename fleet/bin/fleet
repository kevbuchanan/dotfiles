#!/usr/bin/env zsh
# fleet: Claude Code fleets in tmux. Each fleet is one tmux session with an
# orchestrator seat in window `orch` and worker seats w1..wN in window
# `workers`. Seats share task notes in $FLEET_HOME/<fleet>/tasks, a git repo,
# so `git diff` there shows what agents wrote since the last assignment.
#
#   fleet new [name] [dir]       start a fleet and attach to it
#   fleet attach [name]
#   fleet ls                     running fleets, and stopped fleets that
#                                `fleet clean` has not removed
#   fleet kill [name]            default: the calling pane's fleet; worktrees
#                                and notes stay on disk
#   fleet clean <name> [--branches]
#                                remove a stopped fleet's clean worktrees and
#                                its state; --branches also deletes merged
#                                worker branches
#   fleet status
#   fleet task <id> [--from <id>] <title>
#                                create a task note and print its path;
#                                --from starts a follow-up to a closed task
#   fleet assign <seat> <id>     point an idle worker at a task note
#   fleet clear <seat>           /clear an idle seat and drop its task
#   fleet interrupt <seat>       send Escape to the seat
#   fleet restart <seat>         kill the seat's process and relaunch claude
#   fleet rename <seat> <title>
#   fleet path <seat>            print a worker's worktree path
#   fleet answer <id>            tell a worker waiting in state `question`
#                                that its task's questions are answered
#   fleet bump <id>              tell a stopped worker still on a task that
#                                its note has new work
#   fleet diff [--rev] <id> [git diff args]
#                                one task's changes; --rev prints the folder
#                                and revision instead, for :FleetDiff
#   fleet shell <seat> [cmd]     open a window in a worker's worktree, running
#                                cmd or a shell
#
# Seat commands act on the fleet named by -s <fleet>, or else on the fleet
# that owns the calling pane.
#
# Seat commands type into panes with send-keys, and typed input counts as the
# user's. Each command sends only fixed text, so a caller can never answer a
# permission prompt or send a free-form instruction through fleet.
#
# FLEET_HOME          notes root, default ~/agents
# XDG_STATE_HOME      fleet state goes in $XDG_STATE_HOME/fleet/<fleet>,
#                     default ~/.local/state/fleet/<fleet>
# FLEET_WORKERS       worker count for `new`, default 6
# FLEET_WORKER_MODE   worker --permission-mode for `new`, default auto
# CLAUDE_CONFIG_DIR   if set for `new`, every seat runs claude with it
# FLEET_ORCH_MODEL, FLEET_WORKER_MODEL
#                     --model for the orchestrator and for every worker
# FLEET_ORCH_EFFORT, FLEET_WORKER_EFFORT
#                     --effort for each role: low, medium, high, xhigh or max
#                     Unset leaves the config dir's default model and effort.

set -euo pipefail

root=${0:A:h:h}
home=${FLEET_HOME:-$HOME/agents}
# Rendered prompts and settings, and the repo path for `clean`. Seats read
# them at every launch, including `restart`, so they live outside $TMPDIR,
# which macOS empties of files nobody has opened for a few days.
statedir=${XDG_STATE_HOME:-$HOME/.local/state}/fleet

die() { print -u2 "fleet: $*"; exit 1 }

S=
if [[ ${1:-} == -s ]]; then
  S=${2:?fleet name}
  shift 2
fi
cmd=${1:-help}
(( $# )) && shift

is_fleet() { [[ $(tmux show -qv -t "=$1:" @fleet 2> /dev/null) == 1 ]] }

current() {
  if [[ -z $S ]]; then
    [[ -n ${TMUX_PANE:-} ]] || die "not in a fleet pane, pass -s <fleet>"
    S=$(tmux display -p -t $TMUX_PANE '#S')
  fi
  is_fleet $S || die "$S is not a fleet"
  notes=$(tmux show -qv -t "=$S:" @fleet_notes)
}

# Sets $pane rather than printing it. Called in a command substitution, die
# would exit only the subshell and leave the caller with an empty pane id,
# and tmux reads an empty -t as the calling pane.
pane_of() {
  pane=$(tmux list-panes -s -t "=$S:" -F '#{pane_id} #{@agent_seat}' | awk -v s=$1 '$2 == s { print $1 }')
  [[ -n $pane ]] || die "no seat $1 in $S"
}

# Sets $worktree to a worker seat's checkout, which Claude Code creates from
# the -w name on the seat's launch line, or to empty when there is none.
seat_checkout() {
  worktree=
  local record=$statedir/$S/repo
  [[ -f $record ]] || return 0
  local wt=$(< $record)/.claude/worktrees/$S-$1
  [[ -d $wt ]] && worktree=$wt
  return 0
}

# Like seat_checkout, but stops fleet with the reason there is no checkout.
worktree_of() {
  [[ $1 == w<-> ]] || die "only worker seats have worktrees: $1"
  pane_of $1
  [[ -f $statedir/$S/repo ]] || die "$S has no repo record, so its workers have no worktrees"
  seat_checkout $1
  [[ -n $worktree ]] || die "no worktree yet at $(< $statedir/$S/repo)/.claude/worktrees/$S-$1"
}

# Header fields of a task note, the "Key: value" lines under the title.
note_get() { sed -n "s/^$2: *//p" $1 | head -1 }
note_set() {
  local note=$1 key=$2 value=$3
  if grep -q "^$key:" $note; then
    sed -i '' "s|^$key:.*|$key: $value|" $note
  else
    # notes made from an older template lack the field; add it after the
    # last header field, so fields added in turn keep their order
    awk -v line="$key: $value" '
      NR == FNR { if (/^(Guidance|Follows|Worker|Branch|Base|End):/) last = FNR; next }
      { print } FNR == last { print line }
    ' $note $note > $note.tmp
    mv $note.tmp $note
  fi
}

opt() { tmux display -p -t $1 "#{$2}" }

need_idle() {
  local st=$(opt $1 @agent_state)
  [[ $st == idle ]] || die "$2 is ${st:-starting}, not idle"
}

need_id() { [[ $1 =~ '^[A-Za-z0-9_-]+$' ]] || die "task ids use letters, digits, - and _: $1" }

attach() {
  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "=$S:orch"
  else
    tmux attach -t "=$S:orch"
  fi
}

# Claude's own terminal-title updates would overwrite the pane title, so each
# pane keeps the title set here. @agent_cmd is what `restart` relaunches.
launch() {
  local pane=$1 seat=$2 line=$3
  tmux set -p -t $pane @agent_seat $seat
  tmux set -p -t $pane @agent_cmd $line
  tmux set -p -t $pane allow-set-title off
  tmux select-pane -t $pane -T $S-$seat
  tmux send-keys -t $pane $line Enter
}

# pane borders show the seat name and the @agent_state the hooks set
borders() {
  tmux set -w -t $1 pane-border-status top
  tmux set -w -t $1 pane-border-format ' #{pane_title} #{@agent_state} '
}

# Sets $flags to --model and --effort for one role from FLEET_<role>_MODEL and
# _EFFORT. Not printed, so that die stops fleet. They become part of each
# seat's launch line, so `restart` keeps them.
role_flags() {
  local model=${(P)${:-FLEET_$1_MODEL}:-} effort=${(P)${:-FLEET_$1_EFFORT}:-}
  flags=
  [[ -n $model ]] && flags+=" --model ${(q)model}"
  if [[ -n $effort ]]; then
    [[ $effort == (low|medium|high|xhigh|max) ]] || die "FLEET_$1_EFFORT must be low, medium, high, xhigh or max: $effort"
    flags+=" --effort $effort"
  fi
}

fleet_new() {
  S=${1:-${PWD:t}}
  S=${S//[.:]/-}
  local dir=${${2:-$PWD}:A}
  if tmux has-session -t "=$S:" 2> /dev/null; then
    is_fleet $S || die "$S is a tmux session but not a fleet"
    attach
    return
  fi

  local count=${FLEET_WORKERS:-6} mode=${FLEET_WORKER_MODE:-auto}
  local flags orch_flags worker_flags
  role_flags ORCH; orch_flags=$flags
  role_flags WORKER; worker_flags=$flags
  local rundir=$statedir/$S orch=$S-orch
  notes=$home/$S
  mkdir -p $rundir $notes/tasks
  print $notes > $rundir/notes
  if [[ ! -d $notes/.git ]]; then
    git -C $notes init -q
    git -C $notes commit -q --allow-empty -m "fleet $S"
  fi

  local -a workers
  for i in {1..$count}; do workers+=($S-w$i); done

  render() {
    sed -e "s|{{NAME}}|$2|g" -e "s|{{SESSION}}|$S|g" -e "s|{{ORCHESTRATOR}}|$orch|g" \
        -e "s|{{WORKERS}}|${(j:, :)workers}|g" -e "s|{{COUNT}}|$count|g" -e "s|{{NOTES}}|$notes|g" \
        $root/prompts/$1 > $rundir/$2.md
  }

  # every seat may edit the notes; the orchestrator may also run seat commands
  local edit="Edit(/$notes/**)"
  sed "s|{{ROOT}}|$root|g" $root/settings.json > $rundir/settings.json
  jq --arg e $edit '.permissions.allow = [$e]' $rundir/settings.json > $rundir/worker-settings.json
  jq --arg e $edit '.permissions.allow = [$e] + ([
      "status", "task", "assign", "clear", "interrupt", "rename", "path", "diff", "answer", "bump"
    ] | map("Bash(fleet \(.))", "Bash(fleet \(.) *)"))' \
    $rundir/settings.json > $rundir/orch-settings.json

  local base="claude --add-dir ${(q)notes}"
  # Sessions find each other only within one config dir, so every seat gets
  # the same one. It is part of each pane's @agent_cmd, so restart keeps it.
  if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then
    base="CLAUDE_CONFIG_DIR=${(q)${CLAUDE_CONFIG_DIR:A}} $base"
  fi
  # If this call starts the tmux server, the server's environment would carry
  # CLAUDE_CONFIG_DIR into every later pane, fleet or not
  local pane=$(env -u CLAUDE_CONFIG_DIR tmux new-session -d -s $S -n orch -c $dir -P -F '#{pane_id}')
  tmux set -t "=$S:" @fleet 1
  tmux set -t "=$S:" @fleet_notes $notes
  borders "=$S:orch"
  render orchestrator.md $orch
  launch $pane orch "$base -n $orch --settings ${(q)rundir}/orch-settings.json --append-system-prompt-file ${(q)rundir}/$orch.md$orch_flags"

  # nvim on the notes folder, left of the orchestrator. It has no @agent_seat,
  # so seat commands and `fleet status` skip it.
  local editor=$(tmux split-window -hb -d -t $pane -c $notes -P -F '#{pane_id}')
  tmux set -p -t $editor allow-set-title off
  tmux select-pane -t $editor -T $S-notes
  tmux send-keys -t $editor 'nvim .' Enter

  local -a panes
  panes=($(tmux new-window -d -t "=$S:" -n workers -c $dir -P -F '#{pane_id}'))
  for i in {2..$count}; do
    panes+=($(tmux split-window -d -t $panes[-1] -c $dir -P -F '#{pane_id}'))
    tmux select-layout -t "=$S:workers" tiled > /dev/null
  done
  borders "=$S:workers"

  # each worker gets its own worktree so workers never share a checkout
  local worktree=0
  if git -C $dir rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    worktree=1
    git -C $dir rev-parse --show-toplevel > $rundir/repo
  fi

  local name line
  for i in {1..$count}; do
    name=$S-w$i
    render worker.md $name
    line="$base -n $name --settings ${(q)rundir}/worker-settings.json --append-system-prompt-file ${(q)rundir}/$name.md --permission-mode $mode$worker_flags"
    (( worktree )) && line+=" -w $name"
    launch $panes[$i] w$i $line
  done

  attach
}

fleet_status() {
  current
  local pane seat st task progress
  printf '%-8s %-10s %-12s %s\n' SEAT STATE TASK TODOS
  tmux list-panes -s -t "=$S:" -F '#{pane_id} #{@agent_seat}' | while read pane seat; do
    [[ -n $seat ]] || continue
    st=$(opt $pane @agent_state)
    task=$(opt $pane @agent_task)
    progress=
    if [[ -n $task && -f $notes/tasks/$task.md ]]; then
      progress=$($root/hooks/task-progress $notes/tasks/$task.md | awk '{ printf "%d/%d", $1, $2; if ($3) printf ", %d open questions", $3 }')
    fi
    printf '%-8s %-10s %-12s %s\n' $seat ${st:--} ${task:--} $progress
  done
}

# The body of section "## $2" in note $1, up to the next "## " heading.
note_section() { awk -v h="## $2" '$0 == h { on = 1; next } on && /^## / { exit } on' $1 }

# Replaces the body of section "## $2" in note $1 with the contents of file $3.
note_section_set() {
  awk -v h="## $2" -v body=$3 '
    $0 == h { print; while ((getline line < body) > 0) print line; skip = 1; next }
    skip && /^## / { skip = 0 }
    !skip
  ' $1 > $1.tmp
  mv $1.tmp $1
}

fleet_task() {
  current
  local id=${1:?usage: fleet task <id> [--from <id>] <title>} from=
  shift
  local -a words
  while (( $# )); do
    if [[ $1 == --from ]]; then
      from=${2:?--from needs a task id}
      shift 2
    else
      words+=($1)
      shift
    fi
  done
  need_id $id
  local note=$notes/tasks/$id.md prev
  [[ -e $note ]] && die "$note exists"
  if [[ -n $from ]]; then
    need_id $from
    prev=$notes/tasks/$from.md
    [[ -f $prev ]] || die "no task note $prev"
    (( $#words )) || words=(follow-up to $from)
  fi
  local title=${(j: :)words}
  sed -e "s|{{ID}}|$id|" -e "s|{{TITLE}}|${title:-untitled}|" -e "s|{{GUIDANCE}}|$root/guidance/default.md|" \
    $root/templates/task.md > $note

  # A follow-up starts from the earlier task's handoff, with its scope and
  # checks, so the new worker needs none of the earlier conversation
  if [[ -n $from ]]; then
    note_set $note Follows $from
    local body=$(mktemp) sec
    for sec in Scope Verify; do
      note_section $prev $sec > $body
      note_section_set $note $sec $body
    done
    printf '\nFollow-up to [%s](%s.md). Read its Handoff first: it says what %s did and what is left.\n\n' $from $from $from > $body
    note_section_set $note Goal $body
    rm $body
  fi
  print $note
}

fleet_assign() {
  current
  local seat=${1:?seat} id=${2:?task id}
  [[ $seat == w<-> ]] || die "only worker seats take tasks: $seat"
  need_id $id
  local note=$notes/tasks/$id.md pane
  pane_of $seat
  [[ -f $note ]] || die "no task note $note"
  need_idle $pane $seat
  # reassigning would overwrite Base, and `fleet diff` would lose the closed work
  [[ -z $(note_get $note End) ]] || die "$id is closed; put follow-up work in a new task, such as fleet task ${id}-2 --from $id"

  # Base is the worker branch's commit when the task starts, and End is set by
  # `fleet clear`, so `fleet diff` can show this task apart from the branch's
  # earlier and later tasks
  local worktree branch=worktree-$S-$seat base=-
  seat_checkout $seat
  if [[ -n $worktree ]]; then
    branch=$(git -C $worktree symbolic-ref -q --short HEAD || print $branch)
    base=$(git -C $worktree rev-parse HEAD)
  fi

  # A follow-up builds on the earlier task's code, so the worker's branch must
  # already contain that task's End commit
  local follows=$(note_get $note Follows)
  if [[ -n $follows ]]; then
    local prev=$notes/tasks/$follows.md prev_end
    [[ -f $prev ]] || die "$id follows $follows, which has no note"
    prev_end=$(note_get $prev End)
    [[ -n $prev_end ]] || die "$follows is still open; add the work to its note and fleet bump $follows"
    if [[ -n $worktree && $prev_end != - ]] && ! git -C $worktree merge-base --is-ancestor $prev_end HEAD 2> /dev/null; then
      die "$seat's branch doesn't contain $follows's work (${prev_end[1,12]}); assign $id to ${$(note_get $prev Worker)#$S-} or merge $(note_get $prev Branch) into $branch first"
    fi
  fi

  note_set $note Worker $S-$seat
  note_set $note Branch $branch
  note_set $note Base $base
  note_set $note End ""

  # the commit is the baseline that `git diff` in the notes repo compares against
  git -C $notes add -A
  git -C $notes commit -q --allow-empty -m "assign $id to $seat"

  tmux set -p -t $pane @agent_task $id
  tmux send-keys -t $pane -l "Task $id: read $note"
  tmux send-keys -t $pane Enter
}

fleet_clear() {
  current
  local seat=${1:?seat} pane
  pane_of $seat
  need_idle $pane $seat
  local task=$(opt $pane @agent_task) worktree
  if [[ -n $task && -f $notes/tasks/$task.md ]]; then
    seat_checkout $seat
    [[ -n $worktree ]] && note_set $notes/tasks/$task.md End $(git -C $worktree rev-parse HEAD)
  fi
  tmux set -p -u -t $pane @agent_task
  tmux send-keys -t $pane -l /clear
  tmux send-keys -t $pane Enter
}

fleet_restart() {
  current
  local seat=${1:?seat} pane
  pane_of $seat
  local line=$(opt $pane @agent_cmd)
  tmux set -p -u -t $pane @agent_task
  tmux set -p -u -t $pane @agent_state
  tmux respawn-pane -k -t $pane
  tmux send-keys -t $pane $line Enter
}

# A fleet is running while its tmux session exists, and stopped while only its
# state folder does. Fleets from before the state folder have no repo record,
# so their repo and worktrees show as -.
fleet_ls() {
  local -A running
  local name
  for name in ${(f)"$(tmux list-sessions -F '#{session_name} #{@fleet}' 2> /dev/null | awk '$2 == 1 { print $1 }')"}; do
    [[ -n $name ]] && running[$name]=1
  done
  local -a names
  names=(${(ou)${(k)running}} $statedir/*(N/:t))
  names=(${(ou)names})
  (( $#names )) || return 0

  local st repo notes count
  local -a wts
  printf '%-20s %-8s %-9s %-40s %s\n' FLEET STATE WORKTREES REPO NOTES
  for name in $names; do
    st=stopped repo=- notes=$home/$name count=-
    (( ${+running[$name]} )) && st=running
    [[ -f $statedir/$name/repo ]] && repo=$(< $statedir/$name/repo)
    if [[ -f $statedir/$name/notes ]]; then
      notes=$(< $statedir/$name/notes)
    elif [[ $st == running ]]; then
      notes=$(tmux show -qv -t "=$name:" @fleet_notes)
    fi
    if [[ $repo != - ]]; then
      wts=($repo/.claude/worktrees/$name-w<->(N/))
      count=$#wts
    fi
    printf '%-20s %-8s %-9s %-40s %s\n' $name $st $count ${repo/#$HOME/~} ${notes/#$HOME/~}
  done
}

# A window per worker shell: the tiled workers window has no room for more
# panes. It has no @agent_seat, so seat commands and `fleet status` skip it.
fleet_shell() {
  current
  local seat=${1:?seat} worktree pane
  shift
  worktree_of $seat
  local win=$seat-shell
  if tmux list-windows -t "=$S:" -F '#{window_name}' | grep -qx -- $win; then
    (( $# )) && print -u2 "fleet: $win is already open; run the command there"
  else
    pane=$(tmux new-window -d -t "=$S:" -n $win -c $worktree -P -F '#{pane_id}')
    borders "=$S:$win"
    tmux set -p -t $pane allow-set-title off
    tmux select-pane -t $pane -T $S-$win
    (( $# )) && tmux send-keys -t $pane "$*" Enter
  fi
  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "=$S:$win"
  else
    print "opened $S:$win; fleet attach $S to use it"
  fi
}

# One task's changes. While the task is still its seat's current task, the
# diff runs in the worktree from Base, so it includes uncommitted edits to
# tracked files. Once `fleet clear` has recorded End, it is Base..End.
fleet_diff() {
  current
  local rev_only=0
  if [[ ${1:-} == --rev ]]; then
    rev_only=1
    shift
  fi
  local id=${1:?usage: fleet diff [--rev] <task id> [git diff args]}
  shift
  need_id $id
  local note=$notes/tasks/$id.md
  [[ -f $note ]] || die "no task note $note"
  local base=$(note_get $note Base) end=$(note_get $note End) branch=$(note_get $note Branch)
  local seat=${$(note_get $note Worker)#$S-}
  [[ -n $base && $base != - ]] || die "$id has no Base; it was assigned before fleet recorded one, or its workers have no worktrees"
  local repo=$(< $statedir/$S/repo) dir rev pane worktree
  if [[ -n $end ]]; then
    dir=$repo rev=$base..$end
  else
    pane_of $seat
    seat_checkout $seat
    if [[ $(opt $pane @agent_task) == $id && -n $worktree ]]; then
      dir=$worktree rev=$base
    else
      print -u2 "fleet: $id has no End; showing $branch through its latest commit"
      dir=$repo rev=$base..$branch
    fi
  fi
  if (( rev_only )); then
    print -l -- $dir $rev
  else
    git -C $dir diff $rev "$@"
  fi
}

# Sets $note, $seat, $pane and $st for the worker still on task $1, or stops
# fleet when no worker is.
worker_on_task() {
  need_id $1
  note=$notes/tasks/$1.md
  [[ -f $note ]] || die "no task note $note"
  seat=${$(note_get $note Worker)#$S-}
  [[ -n $seat ]] || die "$1 is not assigned"
  pane_of $seat
  [[ $(opt $pane @agent_task) == $1 ]] || die "$seat is no longer on $1; start a follow-up task with fleet task"
  st=$(opt $pane @agent_state)
}

# A worker that stopped, after DONE, a question or a stall, gets no turn
# until something types into its pane. Both commands send only fixed text.
# `waiting` is refused: typed input would answer a permission prompt.
fleet_bump() {
  current
  local id=${1:?usage: fleet bump <task id>} note seat pane st
  worker_on_task $id
  [[ $st == (idle|question|stalled) ]] || die "$seat is ${st:-starting}; bump a worker that is idle, question or stalled"
  tmux send-keys -t $pane -l "Task $id was updated: re-read $note"
  tmux send-keys -t $pane Enter
  print "told $seat that $id was updated"
}

fleet_answer() {
  current
  local id=${1:?usage: fleet answer <task id>} note seat pane st
  worker_on_task $id
  [[ $st == question ]] || die "$seat is ${st:-starting}, not waiting on a question"
  local open=$($root/hooks/task-progress $note | awk '{ print $3 }')
  (( open == 0 )) || die "$id still has $open open questions"
  tmux send-keys -t $pane -l "Questions in $id are answered: re-read $note"
  tmux send-keys -t $pane Enter
  print "told $seat that $id's questions are answered"
}

fleet_clean() {
  S=${1:?usage: fleet clean <name> [--branches]}
  local branches=0
  [[ ${2:-} == --branches ]] && branches=1
  tmux has-session -t "=$S:" 2> /dev/null && die "$S is running; fleet kill $S first"
  local rundir=$statedir/$S
  [[ -d $rundir ]] || die "no state for $S in $rundir"

  local repo wt branch kept=0
  [[ -f $rundir/repo ]] && repo=$(< $rundir/repo)
  if [[ -n $repo ]]; then
    for wt in $repo/.claude/worktrees/$S-w<->(N/); do
      # read the branch before removal; it is the one Claude Code created
      branch=$(git -C $wt symbolic-ref -q --short HEAD || true)
      # git refuses to remove a worktree with uncommitted or untracked changes
      if ! git -C $repo worktree remove $wt; then
        print -u2 "fleet: kept $wt"
        kept=1
        continue
      fi
      print "removed $wt"
      # git branch -d refuses a branch that is not merged, so unmerged work stays
      if (( branches )) && [[ -n $branch ]] && ! git -C $repo branch -d $branch; then
        print -u2 "fleet: kept unmerged branch $branch"
      fi
    done
  fi

  # the repo path is how a later clean finds a worktree that was kept
  (( kept )) && die "kept worktrees with changes; commit or discard them, then rerun fleet clean $S"
  rm -rf $rundir
  print "removed $rundir. Notes stay in $home/$S"
}

case $cmd in
  new) fleet_new "$@" ;;
  attach)
    S=${1:-$S}
    [[ -n $S ]] || die "usage: fleet attach <name>"
    is_fleet $S || die "$S is not a fleet"
    attach
    ;;
  ls) fleet_ls ;;
  kill)
    S=${1:-$S}
    current
    tmux kill-session -t "=$S:"
    ;;
  clean) fleet_clean "$@" ;;
  status) fleet_status ;;
  task) fleet_task "$@" ;;
  assign) fleet_assign "$@" ;;
  clear) fleet_clear "$@" ;;
  interrupt) current; pane_of ${1:?seat}; tmux send-keys -t $pane Escape ;;
  restart) fleet_restart "$@" ;;
  rename) current; pane_of ${1:?seat}; tmux select-pane -t $pane -T ${2:?title} ;;
  path) current; worktree_of ${1:?seat}; print $worktree ;;
  diff) fleet_diff "$@" ;;
  answer) fleet_answer "$@" ;;
  bump) fleet_bump "$@" ;;
  shell) fleet_shell "$@" ;;
  *) sed -n '2,/^$/s/^# \{0,1\}//p' $0; [[ $cmd == help ]] ;;
esac
