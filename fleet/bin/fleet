#!/usr/bin/env zsh
# fleet: Claude Code fleets in tmux. Each fleet is one tmux session with an
# orchestrator seat in window `orch` and worker seats w1..wN in window
# `workers`. Seats share task notes in $FLEET_HOME/<fleet>/tasks, a git repo,
# so `git diff` there shows what agents wrote since the last assignment.
#
#   fleet new [name] [dir] [--workers N] [--worker-mode M]
#             [--orch-model M] [--worker-model M] [--orch-effort E] [--worker-effort E]
#                                start a fleet and attach to it; each flag
#                                overrides the FLEET_* variable of that name
#   fleet attach [name]
#   fleet ls                     running fleets, and stopped fleets that
#                                `fleet clean` has not removed
#   fleet migrate [--dry-run]    convert old-format notes to frontmatter
#   fleet archive [--dry-run]    move closed, shipped-or-unshipped task notes
#                                that no open task links into tasks/archive
#   fleet kill [name]            default: the calling pane's fleet; worktrees
#                                and notes stay on disk
#   fleet clean <name> [--branches]
#                                remove a stopped fleet's clean worktrees and
#                                its state; --branches also deletes merged
#                                worker branches
#   fleet status
#   fleet task <id> [--from <id>] <title>
#                                create a task note and print its path;
#                                --from starts a follow-up to a closed task
#   fleet assign [--no-sync] <seat> <id>
#                                point an idle worker at a task note, first
#                                bringing its branch up to date with the
#                                default branch
#   fleet clear <seat>           /clear an idle seat and drop its task
#   fleet interrupt <seat>       send Escape to the seat
#   fleet restart <seat>         kill the seat's process and relaunch claude;
#                                a seat on a task keeps it
#   fleet abandon <seat>         close the seat's task from any state and
#                                clear the seat
#   fleet rename <seat> <title>
#   fleet path <seat>            print a worker's worktree path
#   fleet answer <id>            tell a worker waiting in state `question`
#                                that its task's questions are answered
#   fleet bump <id>              tell the worker still on a task that its
#                                note has new work
#   fleet report <id> <phase> <text>
#                                a worker's report on its task: progress,
#                                done, blocked or error
#   fleet diff [--rev] [<task id> | <seat>] [git diff args]
#                                one task's changes, or a worker's whole
#                                branch; with neither, the calling worker's
#                                branch. --rev prints the folder and revision
#                                instead, for :FleetDiff
#   fleet shell <seat> [cmd]     open a window in a worker's worktree, running
#                                cmd or a shell
#
# Seat commands act on the fleet named by -s <fleet>, or else on the fleet
# that owns the calling pane.
#
# Task messages (assign, bump, answer, report) go to a seat's Claude Code
# inbox socket, which the register hook records on its pane. Claude Code
# treats them as messages from another session: they can't approve a
# permission prompt, and a busy session reads them between tool calls. Only
# /clear, Escape and the launch line are typed into panes, because commands
# that arrive over the socket don't run. Each message starts with a line
# naming its sender and the skill that handles it.
#
# FLEET_HOME          notes root, default ~/agents
# XDG_STATE_HOME      fleet state goes in $XDG_STATE_HOME/fleet/<fleet>,
#                     default ~/.local/state/fleet/<fleet>
# FLEET_WORKERS       worker count for `new`, default 6
# FLEET_WORKER_MODE   worker --permission-mode for `new`, default auto
# CLAUDE_CONFIG_DIR   if set for `new`, every seat runs claude with it
# FLEET_ORCH_MODEL, FLEET_WORKER_MODEL
#                     --model for the orchestrator and for every worker
# FLEET_ORCH_EFFORT, FLEET_WORKER_EFFORT
#                     --effort for each role: low, medium, high, xhigh or max
#                     Unset leaves the config dir's default model and effort.

set -euo pipefail

root=${0:A:h:h}
home=${FLEET_HOME:-$HOME/agents}
# Rendered prompts and settings, and the repo path for `clean`. Seats read
# them at every launch, including `restart`, so they live outside $TMPDIR,
# which macOS empties of files nobody has opened for a few days.
statedir=${XDG_STATE_HOME:-$HOME/.local/state}/fleet

die() { print -u2 "fleet: $*"; exit 1 }

S=
if [[ ${1:-} == -s ]]; then
  S=${2:?fleet name}
  shift 2
fi
cmd=${1:-help}
(( $# )) && shift

is_fleet() { [[ $(tmux show -qv -t "=$1:" @fleet 2> /dev/null) == 1 ]] }

current() {
  if [[ -z $S ]]; then
    [[ -n ${TMUX_PANE:-} ]] || die "not in a fleet pane, pass -s <fleet>"
    S=$(tmux display -p -t $TMUX_PANE '#S')
  fi
  is_fleet $S || die "$S is not a fleet"
  notes=$(tmux show -qv -t "=$S:" @fleet_notes)
}

# Sets $pane rather than printing it. Called in a command substitution, die
# would exit only the subshell and leave the caller with an empty pane id,
# and tmux reads an empty -t as the calling pane.
pane_of() {
  pane=$(tmux list-panes -s -t "=$S:" -F '#{pane_id} #{@agent_seat}' | awk -v s=$1 '$2 == s { print $1 }')
  [[ -n $pane ]] || die "no seat $1 in $S"
}

# Sets $worktree to a worker seat's checkout, which Claude Code creates from
# the -w name on the seat's launch line, or to empty when there is none.
seat_checkout() {
  worktree=
  local record=$statedir/$S/repo
  [[ -f $record ]] || return 0
  local wt=$(< $record)/.claude/worktrees/$S-$1
  [[ -d $wt ]] && worktree=$wt
  return 0
}

# Like seat_checkout, but stops fleet with the reason there is no checkout.
worktree_of() {
  [[ $1 == w<-> ]] || die "only worker seats have worktrees: $1"
  pane_of $1
  [[ -f $statedir/$S/repo ]] || die "$S has no repo record, so its workers have no worktrees"
  seat_checkout $1
  [[ -n $worktree ]] || die "no worktree yet at $(< $statedir/$S/repo)/.claude/worktrees/$S-$1"
}

# Sets $note to task $1's note: tasks/<id>.md, or wherever fleet archive moved
# it under tasks/archive/, by month (archive/2026-11/<id>.md) or, for notes
# archived before months, flat. With none, the tasks/ path, for creating it.
note_path() {
  note=$notes/tasks/$1.md
  [[ -f $note ]] && return 0
  local -a found
  found=($notes/tasks/archive/**/$1.md(N))
  (( $#found )) && note=$found[1]
  return 0
}

# A task note's fields live in YAML frontmatter, one `key: value` per line
# between `---` lines at the top. `fleet:` and `task:` mark a file as a fleet
# note, which nvim's tree decorator and commands rely on, so they never guess
# from a path. Values are single plain lines, so sed and awk read them.

# Notes from before frontmatter kept "Key: value" lines under the title
legacy_fields='Guidance|Follows|Ship|PR|Worker|Branch|Base|End|Status'
has_frontmatter() { [[ $(head -1 $1) == --- ]] }

note_get() {
  local note=$1 key=$2
  if has_frontmatter $note; then
    awk -v k=$key 'NR == 1 { next } $0 == "---" { exit } index($0, k ":") == 1 { sub(/^[^:]*: */, ""); print; exit }' $note
  else
    local legacy=${(C)key}
    [[ $key == pr ]] && legacy=PR
    sed -n "s/^$legacy: *//p" $note | head -1
  fi
}

note_set() {
  local note=$1 key=$2 value=$3
  has_frontmatter $note || note_migrate $note
  awk -v k=$key -v v=$value '
    NR == 1 { print; next }
    !done && $0 == "---" { if (!set) print k ": " v; print; done = 1; next }
    !done && index($0, k ":") == 1 { print k ": " v; set = 1; next }
    { print }
  ' $note > $note.tmp
  mv $note.tmp $note
}

# Rewrites an old-format note's "Key: value" header lines as frontmatter,
# with the fleet and task marker keys, and keeps everything else.
note_migrate() {
  local note=$1 id=${1:t:r}
  awk -v fleet=$S -v task=$id -v pat="^($legacy_fields): *" '
    function lower(k) { return k == "PR" ? "pr" : tolower(k) }
    !body && /^## / { body = 1 }
    !body && $0 ~ pat {
      key = $0; sub(/:.*/, "", key)
      val = $0; sub(/^[^:]*: */, "", val)
      fields[lower(key)] = val
      next
    }
    !body && /^$/ && blank { next }
    { blank = ($0 == ""); lines[++n] = $0 }
    END {
      print "---"; print "fleet: " fleet; print "task: " task
      split("guidance ship follows pr worker branch base end status", order, " ")
      for (i = 1; i <= 9; i++) if (order[i] in fields) print order[i] ": " fields[order[i]]
      print "---"; print ""
      for (i = 1; i <= n; i++) print lines[i]
    }
  ' $note > $note.tmp
  mv $note.tmp $note
}

opt() { tmux display -p -t $1 "#{$2}" }

# A value made safe for the replacement side of a sed s|...|...| command,
# where &, | and \ are special: a task title such as "fix A & B" would
# otherwise render as "fix A {{TITLE}} B".
sedq() { print -r -- $1 | sed 's/[\\&|]/\\&/g' }

# Commits everything in the notes repo under a lock, so commands running at
# once, such as the orchestrator's parallel assigns, don't collide on git's
# index.lock. mkdir is atomic, which makes the folder a lock.
notes_commit() {
  local lock=$notes/.git/fleet.lock tries=0
  until mkdir $lock 2> /dev/null; do
    (( ++tries > 100 )) && die "the notes repo stayed locked; remove $lock if no fleet command is running"
    sleep 0.1
  done
  { git -C $notes add -A && git -C $notes commit -q --allow-empty -m $1 } always { rmdir $lock }
}

need_idle() {
  local st=$(opt $1 @agent_state)
  [[ $st == idle ]] || die "$2 is ${st:-starting}, not idle"
}

need_id() { [[ $1 =~ '^[A-Za-z0-9_-]+$' ]] || die "task ids use letters, digits, - and _: $1" }

attach() {
  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "=$S:orch"
  else
    tmux attach -t "=$S:orch"
  fi
}

# Claude's own terminal-title updates would overwrite the pane title, so each
# pane keeps the title set here. @agent_cmd is what `restart` relaunches.
launch() {
  local pane=$1 seat=$2 line=$3
  tmux set -p -t $pane @agent_seat $seat
  tmux set -p -t $pane @agent_cmd $line
  tmux set -p -t $pane allow-set-title off
  tmux select-pane -t $pane -T $S-$seat
  tmux send-keys -t $pane "$(launch_line $pane)" Enter
}

# The command typed into a seat's pane. A worker in a git fleet gets `-w` the
# first time, which has Claude Code create its worktree. Once the worktree
# exists, the worker starts inside it instead: a repo's WorktreeCreate hook may
# refuse a name that already exists, and `fleet new` on an earlier fleet's
# name or `fleet restart` would otherwise ask for it again. @agent_cmd holds
# the line without `-w`; lines saved before this ended in it, so it's dropped.
launch_line() {
  local pane=$1 seat=$(opt $1 @agent_seat) cmd=$(opt $1 @agent_cmd)
  cmd=${cmd% -w $S-$seat}
  local record=$statedir/$S/repo
  if [[ $seat != w<-> || ! -f $record ]]; then
    print -r -- $cmd
    return
  fi
  local repo=$(< $record)
  local wt=$repo/.claude/worktrees/$S-$seat
  if git -C $repo worktree list --porcelain | grep -qxF "worktree $wt"; then
    print -r -- "cd ${(q)wt} && $cmd"
  else
    print -r -- "$cmd -w $S-$seat"
  fi
}

# pane borders show the seat name and the @agent_state the hooks set
borders() {
  tmux set -w -t $1 pane-border-status top
  tmux set -w -t $1 pane-border-format ' #{pane_title} #{@agent_state} '
}

# Sets $flags to --model and --effort for one role from FLEET_<role>_MODEL and
# _EFFORT. Not printed, so that die stops fleet. They become part of each
# seat's launch line, so `restart` keeps them.
role_flags() {
  local model=${(P)${:-FLEET_$1_MODEL}:-} effort=${(P)${:-FLEET_$1_EFFORT}:-}
  flags=
  [[ -n $model ]] && flags+=" --model ${(q)model}"
  if [[ -n $effort ]]; then
    [[ $effort == (low|medium|high|xhigh|max) ]] || die "FLEET_$1_EFFORT must be low, medium, high, xhigh or max: $effort"
    flags+=" --effort $effort"
  fi
}

# Creates the fleet-level files beside tasks/ from templates/, leaving any
# that exist as they are, and commits what it adds.
fleet_files() {
  local f added=0
  mkdir -p $notes/knowledge $notes/guidance
  for f in brief.md backlog.md decisions.md knowledge/index.md; do
    [[ -e $notes/$f ]] && continue
    sed "s|{{SESSION}}|$(sedq $S)|g" $root/templates/$f > $notes/$f.tmp && mv $notes/$f.tmp $notes/$f
    added=1
  done
  (( added )) && notes_commit "fleet $S: brief, backlog, decisions and knowledge"
  return 0
}

fleet_new() {
  # Each flag sets the environment variable of the same setting for this
  # fleet, so flags win and the variables remain the fallback. They're
  # locals, which role_flags reads through zsh's dynamic scope.
  local FLEET_WORKERS=${FLEET_WORKERS:-} FLEET_WORKER_MODE=${FLEET_WORKER_MODE:-}
  local FLEET_ORCH_MODEL=${FLEET_ORCH_MODEL:-} FLEET_WORKER_MODEL=${FLEET_WORKER_MODEL:-}
  local FLEET_ORCH_EFFORT=${FLEET_ORCH_EFFORT:-} FLEET_WORKER_EFFORT=${FLEET_WORKER_EFFORT:-}
  local -a positional
  local opt value
  while (( $# )); do
    case $1 in
      --*=*) opt=${1%%=*} value=${1#*=}; shift ;;
      --*) opt=$1; value=${2-}; (( $# >= 2 )) || die "$opt needs a value"; shift 2 ;;
      *) positional+=($1); shift; continue ;;
    esac
    case $opt in
      --workers) FLEET_WORKERS=$value ;;
      --worker-mode) FLEET_WORKER_MODE=$value ;;
      --orch-model) FLEET_ORCH_MODEL=$value ;;
      --worker-model) FLEET_WORKER_MODEL=$value ;;
      --orch-effort) FLEET_ORCH_EFFORT=$value ;;
      --worker-effort) FLEET_WORKER_EFFORT=$value ;;
      *) die "unknown option $opt; see fleet help" ;;
    esac
  done
  [[ -z $FLEET_WORKERS || $FLEET_WORKERS == <1-> ]] || die "workers must be a whole number from 1: $FLEET_WORKERS"
  [[ -z $FLEET_WORKER_MODE || $FLEET_WORKER_MODE == (acceptEdits|auto|bypassPermissions|manual|dontAsk|plan) ]] ||
    die "worker mode must be acceptEdits, auto, bypassPermissions, manual, dontAsk or plan: $FLEET_WORKER_MODE"
  set -- $positional

  S=${1:-${PWD:t}}
  S=${S//[.:]/-}
  # the name becomes a tmux session, a notes folder and a state folder, so a
  # path would nest folders under the notes root
  [[ $S =~ '^[A-Za-z0-9_-]+$' ]] || die "fleet names use letters, digits, - and _: $S"
  local dir=${${2:-$PWD}:A}
  if tmux has-session -t "=$S:" 2> /dev/null; then
    is_fleet $S || die "$S is a tmux session but not a fleet"
    # a fleet started before the fleet-level files existed gets them here
    notes=$(tmux show -qv -t "=$S:" @fleet_notes)
    [[ -d $notes/.git ]] && fleet_files
    attach
    return
  fi

  local count=${FLEET_WORKERS:-6} mode=${FLEET_WORKER_MODE:-auto}
  local flags orch_flags worker_flags
  role_flags ORCH; orch_flags=$flags
  role_flags WORKER; worker_flags=$flags
  local rundir=$statedir/$S orch=$S-orch
  notes=$home/$S
  mkdir -p $rundir $notes/tasks
  print $notes > $rundir/notes
  if [[ ! -d $notes/.git ]]; then
    git -C $notes init -q
    git -C $notes commit -q --allow-empty -m "fleet $S"
  fi
  fleet_files

  local -a workers
  for i in {1..$count}; do workers+=($S-w$i); done

  render() {
    sed -e "s|{{NAME}}|$(sedq $2)|g" -e "s|{{SESSION}}|$(sedq $S)|g" -e "s|{{ORCHESTRATOR}}|$(sedq $orch)|g" \
        -e "s|{{WORKERS}}|$(sedq ${(j:, :)workers})|g" -e "s|{{COUNT}}|$count|g" -e "s|{{NOTES}}|$(sedq $notes)|g" \
        $root/prompts/$1 > $rundir/$2.md
  }

  # every seat may edit the notes; the orchestrator may also run seat commands
  local edit="Edit(/$notes/**)"
  sed "s|{{ROOT}}|$root|g" $root/settings.json > $rundir/settings.json
  jq --arg e $edit '.permissions.allow = [$e, "Bash(fleet report *)"]' $rundir/settings.json > $rundir/worker-settings.json
  jq --arg e $edit '.permissions.allow = [$e] + ([
      "status", "task", "assign", "clear", "interrupt", "rename", "path", "diff", "answer", "bump", "archive"
    ] | map("Bash(fleet \(.))", "Bash(fleet \(.) *)"))' \
    $rundir/settings.json > $rundir/orch-settings.json

  # the plugin carries the fleet:orchestrator and fleet:worker skills, which
  # hold the protocol; seats read a skill when they use it, so edits reach
  # running seats
  local base="claude --add-dir ${(q)notes} --plugin-dir ${(q)root}/plugin"
  # Sessions find each other only within one config dir, so every seat gets
  # the same one. It is part of each pane's @agent_cmd, so restart keeps it.
  if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then
    base="CLAUDE_CONFIG_DIR=${(q)${CLAUDE_CONFIG_DIR:A}} $base"
  fi
  # If this call starts the tmux server, the server's environment would carry
  # CLAUDE_CONFIG_DIR into every later pane, fleet or not
  local pane=$(env -u CLAUDE_CONFIG_DIR tmux new-session -d -s $S -n orch -c $dir -P -F '#{pane_id}')
  tmux set -t "=$S:" @fleet 1
  tmux set -t "=$S:" @fleet_notes $notes
  borders "=$S:orch"
  render orchestrator.md $orch
  launch $pane orch "$base -n $orch --settings ${(q)rundir}/orch-settings.json --append-system-prompt-file ${(q)rundir}/$orch.md$orch_flags"

  # nvim on the notes folder, left of the orchestrator. It has no @agent_seat,
  # so seat commands and `fleet status` skip it.
  local editor=$(tmux split-window -hb -d -t $pane -c $notes -P -F '#{pane_id}')
  tmux set -p -t $editor allow-set-title off
  tmux select-pane -t $editor -T $S-notes
  tmux send-keys -t $editor 'nvim .' Enter

  local -a panes
  panes=($(tmux new-window -d -t "=$S:" -n workers -c $dir -P -F '#{pane_id}'))
  # zsh counts {2..1} down, as 2 1, so one worker needs no loop at all
  (( count > 1 )) && for i in {2..$count}; do
    panes+=($(tmux split-window -d -t $panes[-1] -c $dir -P -F '#{pane_id}'))
    tmux select-layout -t "=$S:workers" tiled > /dev/null
  done
  borders "=$S:workers"

  # each worker gets its own worktree so workers never share a checkout
  # launch_line reads the repo record to decide each worker's worktree; a
  # record left by an earlier fleet of this name must not outlive a move to a
  # folder that isn't a repo
  if git -C $dir rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    git -C $dir rev-parse --show-toplevel > $rundir/repo
  else
    rm -f $rundir/repo
  fi

  local name line
  for i in {1..$count}; do
    name=$S-w$i
    render worker.md $name
    line="$base -n $name --settings ${(q)rundir}/worker-settings.json --append-system-prompt-file ${(q)rundir}/$name.md --permission-mode $mode$worker_flags"
    launch $panes[$i] w$i $line
  done

  attach
}

fleet_status() {
  current
  local pane seat st task progress report
  printf '%-8s %-10s %-28s %-10s %s\n' SEAT STATE TASK REPORT TODOS
  tmux list-panes -s -t "=$S:" -F '#{pane_id} #{@agent_seat}' | while read pane seat; do
    [[ -n $seat ]] || continue
    st=$(opt $pane @agent_state)
    task=$(opt $pane @agent_task)
    progress= report=
    if [[ -n $task && -f $notes/tasks/$task.md ]]; then
      progress=$($root/hooks/task-progress $notes/tasks/$task.md | awk '{ printf "%d/%d", $1, $2; if ($3) printf ", %d open questions", $3 }')
      report=$(note_get $notes/tasks/$task.md status)
    fi
    printf '%-8s %-10s %-28s %-10s %s\n' $seat ${st:--} ${task:--} ${report:--} $progress
  done
}

# The body of section "## $2" in note $1, up to the next "## " heading.
note_section() { awk -v h="## $2" '$0 == h { on = 1; next } on && /^## / { exit } on' $1 }

# Replaces the body of section "## $2" in note $1 with the contents of file $3.
note_section_set() {
  awk -v h="## $2" -v body=$3 '
    $0 == h { print; while ((getline line < body) > 0) print line; skip = 1; next }
    skip && /^## / { skip = 0 }
    !skip
  ' $1 > $1.tmp
  mv $1.tmp $1
}

fleet_task() {
  current
  local id=${1:?usage: fleet task <id> [--from <id>] <title>} from=
  shift
  local -a words
  while (( $# )); do
    if [[ $1 == --from ]]; then
      from=${2:?--from needs a task id}
      shift 2
    else
      words+=($1)
      shift
    fi
  done
  need_id $id
  local note prev
  note_path $id
  [[ -e $note ]] && die "$note exists"
  if [[ -n $from ]]; then
    need_id $from
    note_path $from
    prev=$note
    note=$notes/tasks/$id.md
    [[ -f $prev ]] || die "no task note for $from"
    [[ -n $(note_get $prev end) ]] || die "$from is still open; add the work to its note and fleet bump $from"
    (( $#words )) || words=(follow-up to $from)
  fi
  local title=${(j: :)words}
  # a fleet's own guidance/default.md replaces the built-in one
  local guidance=$root/guidance/default.md
  [[ -f $notes/guidance/default.md ]] && guidance=$notes/guidance/default.md
  # written beside the note and moved into place, so a failed render leaves
  # no half-made note to block a retry
  sed -e "s|{{FLEET}}|$(sedq $S)|" -e "s|{{DATE}}|$(date +%F)|" -e "s|{{ID}}|$id|g" \
      -e "s|{{TITLE}}|$(sedq ${title:-untitled})|" -e "s|{{GUIDANCE}}|$(sedq $guidance)|" \
      $root/templates/task.md > $note.tmp && mv $note.tmp $note || { rm -f $note.tmp; die "could not render $note" }

  # A follow-up starts from the earlier task's handoff, with its scope and
  # checks, so the new worker needs none of the earlier conversation
  if [[ -n $from ]]; then
    note_set $note follows $from
    local body=$(mktemp) sec
    for sec in Scope Verify; do
      note_section $prev $sec > $body
      note_section_set $note $sec $body
    done
    # the link is relative to tasks/, where the new note lives, and reaches
    # a source archived under archive/<month>/
    printf '\nFollow-up to [%s](%s). Read its Handoff first: it says what %s did and what is left.\n\n' $from ${prev#$notes/tasks/} $from > $body
    note_section_set $note Goal $body
    rm $body
  fi
  print $note
}

fleet_assign() {
  current
  local sync=1
  if [[ ${1:-} == --no-sync ]]; then
    sync=0
    shift
  fi
  local seat=${1:?usage: fleet assign [--no-sync] <seat> <task id>} id=${2:?usage: fleet assign [--no-sync] <seat> <task id>}
  [[ $seat == w<-> ]] || die "only worker seats take tasks: $seat"
  need_id $id
  local note pane
  note_path $id
  [[ $note == */archive/* ]] && die "$id is archived; put follow-up work in a new task, such as fleet task ${id}-2 --from $id"
  pane_of $seat
  [[ -f $note ]] || die "no task note $note"
  need_idle $pane $seat
  need_socket $pane
  # reassigning would overwrite Base, and `fleet diff` would lose the closed work
  [[ -z $(note_get $note end) ]] || die "$id is closed; put follow-up work in a new task, such as fleet task ${id}-2 --from $id"
  # one task per seat and one seat per task: a second holder would overwrite
  # base, and a seat's earlier task would never get its end
  local current_task=$(opt $pane @agent_task)
  [[ -z $current_task ]] || die "$seat still holds $current_task; fleet clear $seat first"
  local holder=$(tmux list-panes -s -t "=$S:" -F '#{@agent_task} #{@agent_seat}' | awk -v t=$id '$1 == t { print $2 }')
  [[ -z $holder ]] || die "$holder already holds $id"

  # A follow-up builds on the earlier task's code; check it before touching
  # the worktree, so a refusal leaves nothing changed
  local follows=$(note_get $note follows) prev prev_end
  if [[ -n $follows ]]; then
    prev=$(note=; note_path $follows; print -r -- $note)
    [[ -f $prev ]] || die "$id follows $follows, which has no note"
    prev_end=$(note_get $prev end)
    [[ -n $prev_end ]] || die "$follows is still open; add the work to its note and fleet bump $follows"
  fi

  # Base is the worker branch's commit when the task starts, and End is set by
  # `fleet clear`, so `fleet diff` can show this task apart from the branch's
  # earlier and later tasks
  local worktree branch=worktree-$S-$seat base=-
  seat_checkout $seat
  if [[ -n $worktree ]]; then
    (( sync )) && sync_checkout $worktree $seat
    branch=$(git -C $worktree symbolic-ref -q --short HEAD || print $branch)
    base=$(git -C $worktree rev-parse HEAD)
  fi

  # after the update, the worker's branch must contain the earlier task's end
  if [[ -n $follows ]]; then
    if [[ -n $worktree && $prev_end != - ]] && ! git -C $worktree merge-base --is-ancestor $prev_end HEAD 2> /dev/null; then
      die "$seat's branch doesn't contain $follows's work (${prev_end[1,12]}); assign $id to ${$(note_get $prev worker)#$S-} or merge $(note_get $prev branch) into $branch first"
    fi
  fi

  note_set $note worker $S-$seat
  note_set $note branch $branch
  note_set $note base $base
  note_set $note end ""
  note_set $note status assigned

  # the commit is the baseline that `git diff` in the notes repo compares against
  notes_commit "assign $id to $seat"

  tmux set -p -t $pane @agent_task $id
  tmux select-pane -t $pane -T "$S-$seat: $id"
  post $pane worker "Task $id: read $note"
}

fleet_clear() {
  current
  local seat=${1:?seat} pane
  pane_of $seat
  need_idle $pane $seat
  local task=$(opt $pane @agent_task) worktree
  if [[ -n $task && -f $notes/tasks/$task.md ]]; then
    seat_checkout $seat
    # end closes the task; a fleet outside a repo has no commit to record, so
    # `-` closes it the same way for archive, follow-ups and reassign checks
    if [[ -n $worktree ]]; then
      [[ -n $(git -C $worktree status --porcelain) ]] &&
        print -u2 "fleet: $seat has uncommitted changes; $task's end is its last commit, so they will show in its next task's diff"
      note_set $notes/tasks/$task.md end $(git -C $worktree rev-parse HEAD)
    else
      note_set $notes/tasks/$task.md end -
    fi
    note_set $notes/tasks/$task.md closed $(date +%F)
  fi
  tmux set -p -u -t $pane @agent_task
  tmux select-pane -t $pane -T $S-$seat
  tmux send-keys -t $pane -l /clear
  tmux send-keys -t $pane Enter
}

# A seat holding a task keeps it across the restart: the new session gets
# the task line again once its register hook records the socket, and the
# note's base and todos carry the work on. @agent_state `restarting` tells
# the old session's SessionEnd hook not to report the end.
fleet_restart() {
  current
  local seat=${1:?seat} pane
  pane_of $seat
  local task=$(opt $pane @agent_task) note
  tmux set -p -t $pane @agent_state restarting
  tmux set -p -u -t $pane @agent_socket
  tmux respawn-pane -k -t $pane
  tmux set -p -u -t $pane @agent_state
  tmux send-keys -t $pane "$(launch_line $pane)" Enter
  [[ -n $task ]] || return 0
  note_path $task
  local tries=0
  until [[ -S $(opt $pane @agent_socket) ]]; do
    (( ++tries > 120 )) && die "$seat did not start within a minute; it still holds $task, so run fleet bump $task once it is up"
    sleep 0.5
  done
  post $pane worker "Task $task: your session restarted. Read $note and continue from its Todo and Log."
  print "restarted $seat on $task"
}

# Closes a seat's task from any state, for a worker that is stalled, stuck
# on a question nobody will answer, or whose session ended: the note gets
# end, closed and status abandoned, and the seat drops the task. A live
# session is interrupted and cleared; a dead one stays down until fleet
# restart. The worktree keeps any work, and the next task's diff starts
# from the end recorded here.
fleet_abandon() {
  current
  local seat=${1:?usage: fleet abandon <seat>} pane worktree note
  pane_of $seat
  local task=$(opt $pane @agent_task)
  [[ -n $task ]] || die "$seat holds no task"
  note_path $task
  if [[ -f $note ]]; then
    seat_checkout $seat
    if [[ -n $worktree ]]; then
      note_set $note end $(git -C $worktree rev-parse HEAD)
    else
      note_set $note end -
    fi
    note_set $note closed $(date +%F)
    note_set $note status abandoned
    grep -q '^## Log$' $note || printf '\n## Log\n\n' >> $note
    print -r -- "- $(date '+%Y-%m-%d %H:%M') abandoned: closed by $(sender) from seat state ${$(opt $pane @agent_state):-none}" >> $note
  fi
  tmux set -p -u -t $pane @agent_task
  tmux select-pane -t $pane -T $S-$seat
  if [[ -S $(opt $pane @agent_socket) ]]; then
    tmux send-keys -t $pane Escape
    sleep 0.5
    tmux send-keys -t $pane -l /clear
    tmux send-keys -t $pane Enter
  else
    print -u2 "fleet: $seat has no live session; fleet restart $seat relaunches it"
  fi
  print "abandoned $task on $seat"
}

# A fleet is running while its tmux session exists, and stopped while only its
# state folder does. Fleets from before the state folder have no repo record,
# so their repo and worktrees show as -.
fleet_ls() {
  local -A running
  local name
  for name in ${(f)"$(tmux list-sessions -F '#{session_name} #{@fleet}' 2> /dev/null | awk '$2 == 1 { print $1 }')"}; do
    [[ -n $name ]] && running[$name]=1
  done
  local -a names
  # notes folders whose fleet has neither a session nor a state folder show
  # as `notes`, so leftovers are visible
  names=(${(ou)${(k)running}} $statedir/*(N/:t) $home/*/.git(N/:h:t))
  names=(${(ou)names})
  (( $#names )) || return 0

  local st repo notes count
  local -a wts
  printf '%-20s %-8s %-9s %-40s %s\n' FLEET STATE WORKTREES REPO NOTES
  for name in $names; do
    st=stopped repo=- notes=$home/$name count=-
    (( ${+running[$name]} )) && st=running
    [[ $st == stopped && ! -d $statedir/$name ]] && st=notes
    [[ -f $statedir/$name/repo ]] && repo=$(< $statedir/$name/repo)
    if [[ -f $statedir/$name/notes ]]; then
      notes=$(< $statedir/$name/notes)
    elif [[ $st == running ]]; then
      notes=$(tmux show -qv -t "=$name:" @fleet_notes)
    fi
    if [[ $repo != - ]]; then
      wts=($repo/.claude/worktrees/$name-w<->(N/))
      count=$#wts
    fi
    printf '%-20s %-8s %-9s %-40s %s\n' $name $st $count ${repo/#$HOME/~} ${notes/#$HOME/~}
  done
}

# A window per worker shell: the tiled workers window has no room for more
# panes. It has no @agent_seat, so seat commands and `fleet status` skip it.
fleet_shell() {
  current
  local seat=${1:?seat} worktree pane
  shift
  worktree_of $seat
  local win=$seat-shell
  if tmux list-windows -t "=$S:" -F '#{window_name}' | grep -qx -- $win; then
    (( $# )) && print -u2 "fleet: $win is already open; run the command there"
  else
    pane=$(tmux new-window -d -t "=$S:" -n $win -c $worktree -P -F '#{pane_id}')
    borders "=$S:$win"
    tmux set -p -t $pane allow-set-title off
    tmux select-pane -t $pane -T $S-$win
    (( $# )) && tmux send-keys -t $pane "$*" Enter
  fi
  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "=$S:$win"
  else
    print "opened $S:$win; fleet attach $S to use it"
  fi
}

# One task's changes. While the task is still its seat's current task, the
# diff runs in the worktree from Base, so it includes uncommitted edits to
# tracked files. Once `fleet clear` has recorded End, it is Base..End.
fleet_diff() {
  current
  local rev_only=0
  if [[ ${1:-} == --rev ]]; then
    rev_only=1
    shift
  fi
  local id=${1:-}
  (( $# )) && shift
  # a seat, or no argument from a worker's own pane, means the whole branch;
  # a task note by that name wins, so a task can be called w2
  if [[ -z $id || $id == -* ]]; then
    [[ -n $id ]] && set -- $id "$@"
    id=$(opt ${TMUX_PANE:-none} @agent_seat 2> /dev/null || true)
    [[ $id == w<-> ]] || die "usage: fleet diff [--rev] [<task id> | <seat>] [git diff args]"
  fi
  need_id $id
  local note
  note_path $id
  if [[ ! -f $note && $id == w<-> ]]; then
    branch_diff $id $rev_only "$@"
    return
  fi
  [[ -f $note ]] || die "no task note $note"
  local base=$(note_get $note base) end=$(note_get $note end) branch=$(note_get $note branch)
  local seat=${$(note_get $note worker)#$S-}
  [[ -n $base && $base != - ]] || die "$id has no Base; it was assigned before fleet recorded one, or its workers have no worktrees"
  local repo=$(< $statedir/$S/repo) dir rev pane worktree
  if [[ -n $end ]]; then
    dir=$repo rev=$base..$end
  else
    pane_of $seat
    seat_checkout $seat
    if [[ $(opt $pane @agent_task) == $id && -n $worktree ]]; then
      dir=$worktree rev=$base
    else
      print -u2 "fleet: $id has no End; showing $branch through its latest commit"
      dir=$repo rev=$base..$branch
    fi
  fi
  if (( rev_only )); then
    print -l -- $dir $rev
  else
    git -C $dir diff $rev "$@"
  fi
}

# Sets $note, $seat, $pane and $st for the worker still on task $1, or stops
# fleet when no worker is.
worker_on_task() {
  need_id $1
  note=$notes/tasks/$1.md
  [[ -f $note ]] || die "no task note $note"
  seat=${$(note_get $note worker)#$S-}
  [[ -n $seat ]] || die "$1 is not assigned"
  pane_of $seat
  [[ $(opt $pane @agent_task) == $1 ]] || die "$seat is no longer on $1; start a follow-up task with fleet task"
  st=$(opt $pane @agent_state)
}

# A stopped worker starts a turn when the message arrives, and a busy one
# reads it between tool calls, so any state will do.
fleet_bump() {
  current
  local id=${1:?usage: fleet bump <task id>} note seat pane st
  worker_on_task $id
  post $pane worker "Task $id was updated: re-read $note"
  print "told $seat that $id was updated"
}

fleet_answer() {
  current
  local id=${1:?usage: fleet answer <task id>} note seat pane st
  worker_on_task $id
  [[ $st == question ]] || die "$seat is ${st:-starting}, not waiting on a question"
  local open=$($root/hooks/task-progress $note | awk '{ print $3 }')
  (( open == 0 )) || die "$id still has $open open questions"
  post $pane worker "Questions in $id are answered: re-read $note"
  print "told $seat that $id's questions are answered"
}

# Who a message is from: the seat of the calling pane when it belongs to this
# fleet, otherwise the user.
sender() {
  local seat=
  [[ -n ${TMUX_PANE:-} && $(tmux display -p -t $TMUX_PANE '#S' 2> /dev/null) == $S ]] && seat=$(opt $TMUX_PANE @agent_seat)
  case $seat in
    orch) print "the orchestrator $S-orch" ;;
    w<->) print "worker $S-$seat" ;;
    *) print "the user" ;;
  esac
}

need_socket() {
  local sock=$(opt $1 @agent_socket)
  [[ -n $sock && -S $sock ]] ||
    die "$(opt $1 @agent_seat) has no inbox socket recorded; a seat started before fleet recorded sockets needs fleet restart"
}

# Writes one message to a seat's inbox socket as a JSON line, the format
# Claude Code reads there.
post() {
  local pane=$1 skill=$2 text=$3
  need_socket $pane
  local sock=$(opt $pane @agent_socket) seat=$(opt $pane @agent_seat)
  local msg="From fleet, sent by $(sender) (handle per /fleet:$skill skill):"$'\n'"$text"
  jq -cn --arg c $msg '{type: "user", message: {role: "user", content: $c}}' | nc -U -w 2 $sock > /dev/null ||
    die "could not deliver to $seat at $sock"
}

# A worker's report: recorded in the note's Status field and Log section, and
# sent to the orchestrator. Only the task's own worker reports on it.
fleet_report() {
  current
  local id=${1:?usage: fleet report <task id> <progress|done|blocked|error> <text>} phase=${2:-}
  shift 2 2> /dev/null || die "usage: fleet report <task id> <progress|done|blocked|error> <text>"
  [[ $phase == (progress|done|blocked|error) ]] || die "phase must be progress, done, blocked or error: $phase"
  local text=$* note seat pane st
  [[ -n $text ]] || die "a report needs a line of text"
  worker_on_task $id
  [[ -n ${TMUX_PANE:-} && $TMUX_PANE == $pane ]] || die "only $seat, the worker on $id, reports on it"
  if [[ $phase == done ]]; then
    local -a counts
    counts=($($root/hooks/task-progress $note))
    (( counts[1] == counts[2] )) || die "$id has $(( counts[2] - counts[1] )) unchecked todos; check them or report blocked"
  fi
  # find the orchestrator's socket before writing anything, so a report that
  # can't be delivered (the orchestrator mid-/clear) changes nothing and a
  # retry doesn't log the same line twice
  local orch_pane
  pane=; pane_of orch; orch_pane=$pane
  need_socket $orch_pane
  note_set $note status $phase
  grep -q '^## Log$' $note || printf '\n## Log\n\n' >> $note
  print -r -- "- $(date '+%Y-%m-%d %H:%M') $phase: $text" >> $note
  post $orch_pane orchestrator "Report: $id $phase: $text"
  print "reported $id $phase to the orchestrator"
}

# Sets $default_ref to the default branch as seen from checkout $1: origin's
# HEAD when the repo has one, else main or master. Empty when none exists.
default_branch() {
  local ref
  default_ref=
  for ref in $(git -C $1 symbolic-ref -q --short refs/remotes/origin/HEAD) main master; do
    git -C $1 rev-parse -q --verify $ref^{commit} > /dev/null && { default_ref=$ref; return 0; }
  done
  return 0
}

# Brings worker $2's checkout $1 up to date with the default branch before a
# task starts, so Base comes after the update and the task's diff holds only
# its own work. A branch with no commits of its own fast-forwards; one that
# still carries earlier tasks gets the default branch merged in. A conflict
# aborts the merge and stops the assignment. Uncommitted edits leave the
# checkout untouched.
sync_checkout() {
  local wt=$1 seat=$2 default_ref
  if [[ -n $(git -C $wt status --porcelain) ]]; then
    print -u2 "fleet: $seat's worktree has uncommitted changes; left it as is"
    return 0
  fi
  if git -C $wt remote get-url origin > /dev/null 2>&1; then
    GIT_TERMINAL_PROMPT=0 git -C $wt fetch -q origin 2> /dev/null ||
      print -u2 "fleet: fetching origin failed; updating $seat from the refs on disk"
  fi
  default_branch $wt
  if [[ -z $default_ref ]]; then
    print -u2 "fleet: no default branch found; $seat's branch is not updated"
    return 0
  fi
  if git -C $wt merge-base --is-ancestor $default_ref HEAD; then
    return 0
  elif git -C $wt merge-base --is-ancestor HEAD $default_ref; then
    git -C $wt merge -q --ff-only $default_ref
  elif ! git -C $wt merge -q --no-edit $default_ref > /dev/null; then
    git -C $wt merge --abort
    die "merging $default_ref into $seat's branch conflicts; resolve it with fleet shell $seat, or assign with --no-sync"
  fi
  print "updated $seat's branch from $default_ref"
}

# A worker's branch since it left the default branch, through its working
# tree, so uncommitted edits show.
branch_diff() {
  local seat=$1 rev_only=$2 worktree pane default_ref
  shift 2
  worktree_of $seat
  default_branch $worktree
  [[ -n $default_ref ]] || die "can't find the default branch to diff $seat's branch against"
  local mb=$(git -C $worktree merge-base $default_ref HEAD)
  if (( rev_only )); then
    print -l -- $worktree $mb
  else
    git -C $worktree diff $mb "$@"
  fi
}

# Rewrites the relative markdown links in every file of the notes repo after
# the moves given as old/new path pairs, relative to the repo: a link from a
# moved file is resolved from where the file was, a link to a moved file
# follows it, and each changed link is made relative to where its file is
# now. That covers notes in different archive months and archived notes that
# link the note just moved. Links outside the repo, web links and anchors
# stay as written. perl -i rewrites in place the same way on macOS and GNU.
relink() {
  # only the moved files and those naming one, since perl -i rewrites every
  # file it reads and a new mtime makes an open nvim buffer reload
  local -a files names
  local i
  for (( i = 2; i <= $#; i += 2 )); do
    files+=(${(P)i})
    names+=(-e ${${(P)i}:t})
  done
  files+=(${(f)"$(cd $notes && { grep -rlF --include='*.md' --exclude-dir=.git $names . || true } | sed 's|^\./||')"})
  files=(${(u)files:#})
  (cd $notes && perl -i -pe '
    BEGIN {
      our (%move, %back);
      while (@ARGV) { my $a = shift @ARGV; last if $a eq "::"; $move{$a} = shift @ARGV }
      %back = reverse %move;
    }
    our (%move, %back, $od, $nd, $moved_file);
    if ($. == 1) {
      my $was = $back{$ARGV} // $ARGV;
      $moved_file = exists $back{$ARGV};
      ($od = $was) =~ s{/?[^/]*$}{};
      ($nd = $ARGV) =~ s{/?[^/]*$}{};
    }
    sub norm { my @o; for (split m{/}, $_[0]) { next if $_ eq "" || $_ eq "."; if ($_ eq ".." && @o && $o[-1] ne "..") { pop @o } else { push @o, $_ } } join "/", @o }
    sub rel {
      my @t = split m{/}, $_[0]; my @f = split m{/}, $_[1];
      while (@t > 1 && @f && $t[0] eq $f[0]) { shift @t; shift @f }
      join "/", ("..") x @f, @t;
    }
    s{\]\(([^)\s#]+)(#[^)\s]*)?\)}{
      my ($t, $frag) = ($1, $2 // "");
      my $out = $t;
      unless ($t =~ m{^[a-z][a-z0-9+.-]*:}i || $t =~ m{^/}) {
        my $abs = norm($od eq "" ? $t : "$od/$t");
        if ($abs !~ m{^\.\./} && ($moved_file || exists $move{$abs})) {
          $out = rel($move{$abs} // $abs, $nd);
        }
      }
      "](" . $out . $frag . ")";
    }ge;
    close ARGV if eof;
  ' $@ :: $files)
}

# Moves task notes out of tasks/ once nothing needs them there: closed by
# fleet clear (End set), shipped or not meant to ship (PR set, or Ship no),
# no worker still on them, and no note left in tasks/ that links or follows
# them. The commit records each move as a rename, so history follows.
fleet_archive() {
  current
  local dry=0
  [[ ${1:-} == --dry-run ]] && dry=1
  local -a open moved
  local f id ship
  open=($notes/tasks/*.md(N))
  for f in $open; do
    id=${f:t:r}
    [[ -n $(note_get $f end) ]] || continue
    ship=$(note_get $f ship)
    # pr and draft ship through a PR the note records; no and push have none,
    # and an abandoned task ships nothing
    [[ $ship != (pr|draft) || -n $(note_get $f pr) || $(note_get $f status) == abandoned ]] || continue
    tmux list-panes -s -t "=$S:" -F '#{@agent_task}' | grep -qxF -- $id && continue
    moved+=($id)
  done
  # A note stays while a link to it, or a follows: line naming it, sits in a
  # note that stays. Notes moving together don't hold each other back, and
  # each note dropped here can hold back others, so this runs until nothing
  # changes.
  local -a staying
  local changed=1
  while (( changed )); do
    changed=0
    staying=(${open:#(${(j:|:)~${moved/#/$notes/tasks/}}).md})
    for id in $moved; do
      if grep -lE -- "\]\($id\.md\)|\(tasks/$id\.md\)|^[Ff]ollows: *$id\$" $staying /dev/null | grep -q .; then
        moved=(${moved:#$id})
        changed=1
      fi
    done
  done
  if (( ! $#moved )); then
    print "nothing to archive"
    return 0
  fi
  if (( dry )); then
    print -l -- "would archive:" $moved
    return 0
  fi
  # Each note goes into the month it closed, tasks/archive/<YYYY-MM>/, or
  # this month for a note closed before notes recorded `closed:`
  local month closed
  local -a moves
  for id in $moved; do
    closed=$(note_get $notes/tasks/$id.md closed)
    month=${closed[1,7]}
    [[ $month == <->-<-> ]] || month=$(date +%Y-%m)
    mkdir -p $notes/tasks/archive/$month
    mv $notes/tasks/$id.md $notes/tasks/archive/$month/$id.md
    moves+=(tasks/$id.md tasks/archive/$month/$id.md)
  done
  relink $moves
  notes_commit "archive ${(j:, :)moved}"
  print -l -- "archived:" $moved
}

# Converts every old-format note, in tasks/ and tasks/archive/, to
# frontmatter and commits. note_set converts a note the first time it writes
# one, so this only hurries the rest along.
fleet_migrate() {
  current
  local dry=0 f
  [[ ${1:-} == --dry-run ]] && dry=1
  local -a old
  for f in $notes/tasks/*.md(N) $notes/tasks/archive/**/*.md(N); do
    has_frontmatter $f || old+=($f)
  done
  if (( ! $#old )); then
    print "every note has frontmatter"
    return 0
  fi
  if (( dry )); then
    print -l -- "would migrate:" ${old:t:r}
    return 0
  fi
  for f in $old; do note_migrate $f; done
  notes_commit "migrate ${#old} notes to frontmatter"
  print -l -- "migrated:" ${old:t:r}
}

fleet_clean() {
  S=${1:?usage: fleet clean <name> [--branches]}
  local branches=0
  [[ ${2:-} == --branches ]] && branches=1
  tmux has-session -t "=$S:" 2> /dev/null && die "$S is running; fleet kill $S first"
  local rundir=$statedir/$S
  [[ -d $rundir ]] || die "no state for $S in $rundir"

  local repo wt branch kept=0
  [[ -f $rundir/repo ]] && repo=$(< $rundir/repo)
  if [[ -n $repo ]]; then
    for wt in $repo/.claude/worktrees/$S-w<->(N/); do
      # read the branch before removal; it is the one Claude Code created
      branch=$(git -C $wt symbolic-ref -q --short HEAD || true)
      # git refuses to remove a worktree with uncommitted or untracked changes
      if ! git -C $repo worktree remove $wt; then
        print -u2 "fleet: kept $wt"
        kept=1
        continue
      fi
      print "removed $wt"
      # git branch -d refuses a branch that is not merged, so unmerged work stays
      if (( branches )) && [[ -n $branch ]] && ! git -C $repo branch -d $branch; then
        print -u2 "fleet: kept unmerged branch $branch"
      fi
    done
  fi

  # the repo path is how a later clean finds a worktree that was kept
  (( kept )) && die "kept worktrees with changes; commit or discard them, then rerun fleet clean $S"
  rm -rf $rundir
  print "removed $rundir. Notes stay in $home/$S"
}

case $cmd in
  new) fleet_new "$@" ;;
  attach)
    S=${1:-$S}
    [[ -n $S ]] || die "usage: fleet attach <name>"
    is_fleet $S || die "$S is not a fleet"
    attach
    ;;
  ls) fleet_ls ;;
  kill)
    S=${1:-$S}
    current
    # the seats' SessionEnd hooks would otherwise notify a dying orchestrator
    tmux set -t "=$S:" @fleet_stopping 1
    tmux kill-session -t "=$S:"
    ;;
  clean) fleet_clean "$@" ;;
  status) fleet_status ;;
  task) fleet_task "$@" ;;
  assign) fleet_assign "$@" ;;
  clear) fleet_clear "$@" ;;
  interrupt) current; pane_of ${1:?seat}; tmux send-keys -t $pane Escape ;;
  restart) fleet_restart "$@" ;;
  abandon) fleet_abandon "$@" ;;
  rename) current; pane_of ${1:?seat}; tmux select-pane -t $pane -T ${2:?title} ;;
  path) current; worktree_of ${1:?seat}; print $worktree ;;
  diff) fleet_diff "$@" ;;
  answer) fleet_answer "$@" ;;
  archive) fleet_archive "$@" ;;
  migrate) fleet_migrate "$@" ;;
  bump) fleet_bump "$@" ;;
  report) fleet_report "$@" ;;
  shell) fleet_shell "$@" ;;
  *) sed -n '2,/^$/s/^# \{0,1\}//p' $0; [[ $cmd == help ]] ;;
esac
