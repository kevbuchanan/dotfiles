{
  "crossSessionInbound": "accept",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ROOT}}/hooks/agent-state idle"
          },
          {
            "type": "command",
            "command": "{{ROOT}}/hooks/register"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ROOT}}/hooks/agent-state busy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ROOT}}/hooks/agent-state busy"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "{{ROOT}}/hooks/agent-state waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ROOT}}/hooks/todo-check"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ROOT}}/hooks/session-end"
          }
        ]
      }
    ]
  }
}
