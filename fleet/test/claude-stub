#!/usr/bin/python3
# Stands in for claude in fleet's tests. It does what fleet relies on a seat
# doing: with -w <name>, it creates the worktree Claude Code would, under
# .claude/worktrees/<name>; it binds an inbox socket and runs the real
# register hook on it, as SessionStart would; and it records what reaches
# it. Socket messages go to <socket>.inbox and typed lines to <socket>.typed,
# one per line. A typed /clear runs register again, as a new session would.
import os, socket, subprocess, sys, threading

hooks = os.path.join(os.environ["FLEET_ROOT"], "hooks")
pane = os.environ["TMUX_PANE"]
args = sys.argv[1:]
if "-w" in args:
    name = args[args.index("-w") + 1]
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
    wt = os.path.join(top, ".claude", "worktrees", name)
    subprocess.run(["git", "-C", top, "worktree", "add", "-q", "-b", name, wt], check=True)
    os.chdir(wt)

sock = os.path.join(os.environ["FLEET_TEST_SOCKS"], "%d.sock" % os.getpid())
server = socket.socket(socket.AF_UNIX)
server.bind(sock)
server.listen(8)

def session_start():
    env = dict(os.environ, CLAUDE_CODE_MESSAGING_SOCKET=sock)
    subprocess.run([os.path.join(hooks, "register")], env=env, input=b"{}")
    subprocess.run([os.path.join(hooks, "agent-state"), "idle"])

def serve():
    while True:
        conn, _ = server.accept()
        # each message is one JSON line, and nc keeps its end open after
        # sending, so the newline marks the end of the message
        data = b""
        while not data.endswith(b"\n") and (chunk := conn.recv(65536)):
            data += chunk
        conn.close()
        with open(sock + ".inbox", "ab") as f:
            f.write(data if data.endswith(b"\n") else data + b"\n")

threading.Thread(target=serve, daemon=True).start()
session_start()
for line in sys.stdin:
    with open(sock + ".typed", "a") as f:
        f.write(line)
    if line.strip() == "/clear":
        session_start()
