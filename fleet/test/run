#!/usr/bin/env zsh
# fleet's end-to-end tests. Each run starts a fleet on its own tmux server,
# with claude replaced by test/claude-stub, in a scratch repo, notes folder
# and state folder, so it never touches a running fleet or your notes.
#
#   test/run           run every test
#   test/run -k        keep the scratch folder and tmux server for a look
#
# Tests run in order and share the one fleet, each starting from the state
# the one before left.

emulate zsh
setopt err_return no_unset pipe_fail extended_glob

root=${0:A:h:h}
keep=0
[[ ${1:-} == -k ]] && keep=1

# the real nvim, for the review test; $T/bin's nvim is a stub for the notes pane
real_nvim=$(command -v nvim)
T=$(mktemp -d)
T=${T:A}
server=fleet-test-$$
mkdir -p $T/bin $T/socks $T/repo
# tmux reads the server name and config from the wrapper, so fleet, the hooks
# and the stub all reach the test server through plain `tmux`
print -r -- "#!/bin/sh
exec $(command -v tmux) -L $server -f $T/tmux.conf \"\$@\"" > $T/bin/tmux
ln -s $root/test/claude-stub $T/bin/claude
print '#!/bin/sh\nexec cat > /dev/null' > $T/bin/nvim
# gh and glab answer for the pull and merge requests test_pair_modes uses
cat > $T/bin/gh <<'EOF'
#!/bin/sh
case "$*" in
  "pr view 7 --json "*) echo '{"headRefName":"feat/x","isCrossRepository":false,"title":"Add x","url":"https://github.com/acme/shop/pull/7"}' ;;
  "pr view 8 --json "*) echo '{"headRefName":"x-fork","isCrossRepository":true,"title":"Fork x","url":"https://github.com/acme/shop/pull/8"}' ;;
  *) echo "gh stub: $*" >&2; exit 1 ;;
esac
EOF
cat > $T/bin/glab <<'EOF'
#!/bin/sh
case "$*" in
  "mr view 5 -F json") echo '{"source_branch":"feat/y","title":"Y","web_url":"https://gitlab.example.com/acme/shop/-/merge_requests/5","source_project_id":1,"target_project_id":1}' ;;
  *) echo "glab stub: $*" >&2; exit 1 ;;
esac
EOF
chmod +x $T/bin/tmux $T/bin/nvim $T/bin/gh $T/bin/glab
print -r -- "set -g default-command \"env PATH=$T/bin:$root/bin:$PATH zsh -f\"" > $T/tmux.conf

unset TMUX TMUX_PANE CLAUDE_CONFIG_DIR CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN
fleet_vars=(${(M)${(k)parameters}:#FLEET_*})
(( $#fleet_vars )) && unset $fleet_vars
export PATH=$T/bin:$root/bin:$PATH FLEET_HOME=$T/agents XDG_STATE_HOME=$T/state
export FLEET_ROOT=$root FLEET_TEST_SOCKS=$T/socks
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com

cleanup() {
  if (( keep )); then
    print "kept $T; tmux -L $server attach -t demo, and tmux -L $server kill-server when done"
  else
    tmux kill-server 2> /dev/null || true
    # tmux leaves its socket file behind when the server exits
    rm -f ${TMUX_TMPDIR:-/tmp}/tmux-$UID/$server
    rm -rf $T
  fi
}
trap cleanup EXIT

# --- assertions ---

integer passed=0 failed=0
current_test=

pass() { (( ++passed )) }
fail() {
  (( ++failed ))
  print -u2 "  FAIL $current_test: $*"
}
# check <description> <command...>
check() {
  local what=$1
  shift
  if "$@" > /dev/null 2>&1; then pass; else fail $what; fi
}
# refuses <description> <command...>: the command must fail
refuses() {
  local what=$1
  shift
  if "$@" > /dev/null 2>&1; then fail "$what: it succeeded"; else pass; fi
}
# eq <description> <actual> <expected>
eq() {
  if [[ $2 == $3 ]]; then pass; else fail "$1: got '$2', want '$3'"; fi
}
# within <seconds> <command...>: polls until the command succeeds
within() {
  local tries=$(( $1 * 10 ))
  shift
  until "$@" > /dev/null 2>&1; do
    (( --tries > 0 )) || return 1
    sleep 0.1
  done
}
has() { grep -qE -- $2 $1 2> /dev/null }

run_test() {
  current_test=$1
  print "$1"
  $1 || fail "stopped early"
}

# --- helpers ---

fleet() { command fleet -s demo "$@" }
pane() { tmux list-panes -s -t '=demo:' -F '#{pane_id} #{@agent_seat}' | awk -v s=$1 '$2 == s { print $1 }' }
popt() { tmux display -p -t $(pane $1) "#{$2}" }
sock() { popt $1 @agent_socket }
inbox() { print -r -- $(sock $1).inbox }
typed() { print -r -- $(sock $1).typed }
messages() { [[ -f $(inbox $1) ]] && jq -r .message.content $(inbox $1) }
received() { messages $1 | grep -qF -- $2 }
note() { print -r -- $T/agents/demo/tasks/$1.md }
field() { awk -v k=$2 'NR == 1 { next } /^---$/ { exit } index($0, k ": ") == 1 { print substr($0, length(k) + 3) }' $1 }
wt() { print -r -- $T/repo/.claude/worktrees/demo-$1 }
# replaces a note's Todo section with the given items
todos() {
  local f=$(note $1) item
  shift
  local -a lines
  for item in "$@"; do lines+=("- $item"); done
  # through the environment, since BSD awk refuses a newline in -v
  ITEMS=${(pj:\n:)lines} awk '
    $0 == "## Todo" { print; print ""; print ENVIRON["ITEMS"]; print ""; skip = 1; next }
    skip && /^## / { skip = 0 }
    !skip' $f > $f.tmp && mv $f.tmp $f
}
# runs a command as if from a seat's pane, the way its Bash tool would
as() {
  local seat=$1
  shift
  TMUX_PANE=$(pane $seat) "$@"
}
seats_up() {
  local seat
  for seat in orch w1 w2; do
    [[ -S $(sock $seat) && $(popt $seat @agent_state) == idle ]] || return 1
  done
}

# --- tests ---

test_new() {
  git -C $T/repo init -q -b main
  git -C $T/repo commit -q --allow-empty -m init
  for extra in repo2 repo3; do
    git init -q -b main $T/$extra && git -C $T/$extra commit -q --allow-empty -m init
  done
  # with no terminal to attach to, fleet new's last step fails; the fleet runs
  (cd $T && command fleet new demo $T/repo --workers 2 --worker-model sonnet --orch-effort high --repo $T/repo2 > $T/new.log 2>&1 &)
  check "the fleet's seats register sockets" within 20 seats_up
  check "w1's worktree exists" test -d $(wt w1)
  check "the notes repo has a brief" test -f $T/agents/demo/brief.md
  check "the notes folder is a git repo" test -d $T/agents/demo/.git
  check "the state folder records the repo" test -f $T/state/fleet/demo/repo
  eq "fleet ls lists the fleet as running" "$(command fleet ls | awk '$1 == "demo" { print $2 }')" running
  check "workers get --worker-model" eval "[[ \$(popt w1 @agent_cmd) == *' --permission-mode auto --model sonnet' ]]"
  check "the orchestrator gets --orch-effort" eval "[[ \$(popt orch @agent_cmd) == *' --effort high' ]]"
  check "the orchestrator gets no worker model" eval "[[ \$(popt orch @agent_cmd) != *--model* ]]"
  local state=$T/state/fleet/demo
  check "the orchestrator may run fleet status" eval "jq -e '.permissions.allow | index(\"Bash(fleet status)\")' $state/orch-settings.json"
  check "workers may run fleet report" eval "jq -e '.permissions.allow | index(\"Bash(fleet report *)\")' $state/worker-settings.json"
  eq "the windows, in order" "$(tmux list-windows -t '=demo:' -F '#{window_name}' | xargs)" "orch workers shell"
  check "the shell window starts in the project folder" within 3 eval "[[ \$(tmux display -p -t '=demo:shell' '#{pane_current_path}') == $T/repo ]]"
  eq "the shell window is no seat" "$(tmux display -p -t '=demo:shell' '#{@agent_seat}')" ""
  eq "the fleet records its second repo" "$(< $T/state/fleet/demo/repos)" $T/repo2
  check "seats may edit the second repo" eval "[[ \$(popt w1 @agent_cmd) == *'--add-dir $T/repo2 '* ]]"
  check "the hooks' paths are filled in" eval "! grep -q '{{ROOT}}' $state/settings.json && grep -q $root/hooks/session-end $state/settings.json"
}

test_new_flags() {
  refuses "zero workers" command fleet new bad --workers 0
  refuses "a word for workers" command fleet new bad --workers many
  refuses "an unknown worker mode" command fleet new bad --worker-mode yolo
  refuses "an unknown effort" command fleet new bad --orch-effort huge
  refuses "an unknown flag" command fleet new bad --colour blue
  refuses "a flag with no value" command fleet new bad --workers
  refuses "a name with a slash" command fleet new a/b
  # the default name comes from the folder as the shell names it, so a
  # symlinked folder gives its own name; both names here are invalid, so
  # nothing starts either way
  mkdir -p "$T/re al" && ln -s "$T/re al" "$T/li nk"
  eq "the default name follows a symlinked folder's own name" \
    "$(cd "$T/li nk" && PWD="$T/li nk" command fleet new 2>&1)" "fleet: fleet names use letters, digits, - and _: li nk"
  check "a library path variable doesn't stop fleet" env LD_LIBRARY_PATH=$T command fleet ls
  check "a refused fleet leaves no session" eval "! tmux has-session -t '=bad:'"
  check "a refused fleet leaves no notes" test ! -e $T/agents/bad
}

test_task() {
  check "fleet task creates a note" fleet task alpha first task
  eq "the note names its fleet" "$(field $(note alpha) fleet)" demo
  eq "a new task needs no approval" "$(field $(note alpha) approve)" no
  eq "the note has its title" "$(grep -m1 '^# ' $(note alpha))" "# alpha: first task"
  check "a title with \$ patterns" fleet task tz 'charge $$5 for $& and' "\$'x"
  eq "the title is kept as written" "$(grep -m1 '^# ' $(note tz))" "# tz: charge \$\$5 for \$& and \$'x"
  eq "the note has one Goal section" "$(grep -c '^## Goal$' $(note tz))" 1
  rm $(note tz)
  refuses "a duplicate id" fleet task alpha again
  refuses "an id with a slash" fleet task a/b bad
  refuses "a numbered id" fleet task T3 a plan step
  refuses "a bare number" fleet task 42 a plan step
  refuses "a follow-up to an open task" fleet task alpha-b --from alpha
}

test_assign() {
  todos alpha '[ ] one' '[ ] two'
  # a commit on main after the worktree was made, which assign merges in
  git -C $T/repo commit -q --allow-empty -m "main moves on"
  local main=$(git -C $T/repo rev-parse main)
  check "fleet assign" fleet assign w1 alpha
  eq "w1's branch has main's commit" "$(git -C $(wt w1) rev-parse HEAD)" $main
  eq "the note records the worker" "$(field $(note alpha) worker)" demo-w1
  eq "the note records the base" "$(field $(note alpha) base)" $main
  eq "the note is assigned" "$(field $(note alpha) status)" assigned
  eq "the seat holds the task" "$(popt w1 @agent_task)" alpha
  check "w1 gets the task" within 3 received w1 "Task alpha: read $(note alpha)"
  check "the assign is committed in the notes repo" git -C $T/agents/demo log -1 --format=%s --grep='assign alpha'
  fleet task beta second > /dev/null
  refuses "a second task on a busy seat" fleet assign w1 beta
  tmux set -p -t $(pane w2) @agent_state busy
  refuses "a seat that isn't idle" fleet assign w2 beta
  tmux set -p -t $(pane w2) @agent_state idle
}

test_seat_commands() {
  eq "fleet path" "$(fleet path w1)" $(wt w1)
  refuses "path for the orchestrator" fleet path orch
  refuses "path for a seat that doesn't exist" fleet path w9
  check "fleet rename" fleet rename w2 hello
  eq "the pane has the new title" "$(popt w2 pane_title)" hello
  check "fleet interrupt" fleet interrupt w2
  check "fleet bump" fleet bump alpha
  check "w1 gets the bump" within 3 received w1 "Task alpha was updated: re-read $(note alpha)"
  refuses "bump on an unassigned task" fleet bump beta
  refuses "answer while the seat isn't on a question" fleet answer alpha
  tmux set -p -t $(pane w1) @agent_state question
  awk '{ print } $0 == "## Questions" { print ""; print "- [ ] Q1: which way?" }' $(note alpha) > $T/q.md && mv $T/q.md $(note alpha)
  refuses "answer with an open question" fleet answer alpha
  sed -i.bak 's/^- \[ \] Q1:/- [x] Q1:/' $(note alpha) && rm $(note alpha).bak
  check "fleet answer" fleet answer alpha
  check "w1 gets the answer" within 3 received w1 "Questions in alpha are answered: re-read $(note alpha)"
  tmux set -p -t $(pane w1) @agent_state idle
  eq "fleet status's header" "$(fleet status | head -1)" "SEAT     STATE      TASK                         REPORT     TODOS"
  eq "fleet shell outside tmux" "$(fleet shell w1 true)" "opened demo:w1-shell; fleet attach demo to use it"
  check "the shell window is open" eval "tmux list-windows -t '=demo:' -F '#{window_name}' | grep -qx w1-shell"
  check "the shell window starts in the worktree" within 3 eval "[[ \$(tmux display -p -t '=demo:w1-shell' '#{pane_current_path}') == $(wt w1) ]]"
  eq "fleet shell on an open window" "$(fleet shell w1 true 2>&1 >/dev/null)" "fleet: w1-shell is already open; run the command there"
  refuses "clean while the fleet runs" command fleet clean demo
  refuses "a seat command on a session that isn't a fleet" command fleet -s nope status
}

# :FleetComment and :FleetReview in a headless nvim with only fleet's plugin,
# on a file in w1's worktree: the seat's task comes from tmux
test_nvim_review() {
  local f=$(wt w1)/review.txt lua=$T/review.lua
  print -l 'first line' '  if (token == null) return' > $f
  print -r -- "vim.cmd('edit $f')
vim.cmd('2')
vim.cmd('FleetComment use the shared guard')
vim.cmd('FleetReview')
vim.wait(3000, function() return false end)" > $lua
  $real_nvim --clean --headless --cmd "set rtp+=$root/nvim" --cmd 'runtime plugin/fleet.lua' -c "luafile $lua" -c 'qa!' > /dev/null 2>&1
  check "the comment is a review todo in alpha's note" has $(note alpha) '^- \[ \] Review review\.txt:2 `if \(token == null\) return`: use the shared guard$'
  check "w1 gets the bump" within 3 received w1 "Task alpha was updated"
  rm $f
}

test_pair() {
  eq "fleet pair warns that the worker shares the checkout" "$(fleet pair alpha 2>&1 >/dev/null)" "fleet: w1 still holds alpha and may be editing $(wt w1) too"
  local win='=demo:alpha-pair'
  eq "the pair window has two panes" "$(tmux list-panes -t $win | wc -l | tr -d ' ')" 2
  local agent=$(tmux list-panes -t $win -F '#{pane_id} #{pane_title}' | awk '$2 == "demo-alpha-claude" { print $1 }')
  check "the agent pane starts in w1's worktree" within 3 eval "[[ \$(tmux display -p -t $agent '#{pane_current_path}') == $(wt w1) ]]"
  check "claude starts" within 5 eval "[[ -S \$(tmux display -p -t $agent '#{@agent_socket}') ]]"
  local argv=$(tmux display -p -t $agent '#{@agent_socket}').argv
  check "claude gets its own session name" eval "grep -qx demo-alpha-pair $argv"
  check "the prompt names the task's note" eval "grep -qF 'Its note is $(note alpha).' $argv"
  check "the prompt comes after --, past --add-dir" eval "[[ \$(grep -A1 -x -- -- $argv | tail -1) == 'You are pairing'* ]]"
  check "the session loads the fleet plugin" eval "grep -qx $root/plugin $argv"
  check "the prompt points at the pair skill" eval "grep -qF /fleet:pair $argv"
  check "the prompt says the worker may be working there" eval "grep -qF 'w1, the fleet' $argv"
  eq "the pair panes are no seats" "$(tmux list-panes -t $win -F '#{@agent_seat}' | tr -d '\n')" ""
  eq "fleet pair by seat opens the same window" "$(fleet pair w1)" "opened demo:alpha-pair; fleet attach demo to use it"
  eq "it stays one window" "$(tmux list-windows -t '=demo:' -F '#{window_name}' | grep -c '^alpha-pair$')" 1
  local wts=$T/repo/.claude/worktrees main=$(git -C $T/repo rev-parse main)
  # a fleet started with CLAUDE_CONFIG_DIR gives its pair panes the folder
  local orch_cmd=$(popt orch @agent_cmd)
  tmux set -p -t $(pane orch) @agent_cmd "CLAUDE_CONFIG_DIR='$T/my config' $orch_cmd"
  check "fleet pair on an unassigned task" fleet pair beta
  tmux set -p -t $(pane orch) @agent_cmd $orch_cmd
  local agent2=$(tmux list-panes -t '=demo:beta-pair' -F '#{pane_id} #{pane_title}' | awk '$2 == "demo-beta-claude" { print $1 }')
  check "the pane's claude gets the fleet's config folder" within 5 eval "grep -qx 'CLAUDE_CONFIG_DIR=$T/my config' \$(tmux display -p -t $agent2 '#{@agent_socket}').env"
  check "it gets a worktree of its own" within 3 eval "[[ \$(tmux display -p -t '=demo:beta-pair.0' '#{pane_current_path}') == $wts/demo-pair-beta ]]"
  eq "detached at the default branch" "$(git -C $wts/demo-pair-beta rev-parse HEAD)" $main
  check "a detached head" test -z "$(git -C $wts/demo-pair-beta symbolic-ref -q HEAD)"

  # a closed task whose branch is free and contains its end, and one whose
  # branch moved past it
  git -C $T/repo branch featx main
  fleet task iota closed one > /dev/null
  sed -i.bak -e "s/^end:.*/end: $main/" -e "s/^branch:.*/branch: featx/" $(note iota) && rm $(note iota).bak
  check "fleet pair on a closed task" fleet pair iota
  eq "it checks out the task's branch" "$(git -C $wts/demo-pair-iota symbolic-ref -q --short HEAD)" featx
  local agent9=$(tmux list-panes -t '=demo:iota-pair' -F '#{pane_id} #{pane_title}' | awk '$2 == "demo-iota-claude" { print $1 }')
  check "the prompt names the end it starts from" within 5 eval "grep -qF \"That is this task's end, ${main[1,12]}\" \$(tmux display -p -t $agent9 '#{@agent_socket}').argv"
  fleet task kappa --from iota > /dev/null
  tmux kill-window -t '=demo:iota-pair'
  git -C $T/repo worktree remove $wts/demo-pair-iota
  git -C $T/repo branch -f featx $(git -C $T/repo commit-tree -p $main -m "after iota" "$main^{tree}")
  check "fleet pair on a follow-up nobody started" fleet pair kappa
  eq "it starts from the followed task's branch" "$(git -C $wts/demo-pair-kappa symbolic-ref -q --short HEAD)" featx
  local agent10=$(tmux list-panes -t '=demo:kappa-pair' -F '#{pane_id} #{pane_title}' | awk '$2 == "demo-kappa-claude" { print $1 }')
  check "the prompt counts the commits past that end" within 5 eval "grep -qF '1 commits past ${main[1,12]}, the end of iota' \$(tmux display -p -t $agent10 '#{@agent_socket}').argv"

  for w in alpha beta kappa; do tmux kill-window -t "=demo:$w-pair"; done
  for w in beta kappa; do git -C $T/repo worktree remove --force $wts/demo-pair-$w; done
  git -C $T/repo branch -q -D featx
  rm $(note iota) $(note kappa)
}

# pair on a branch, a folder, and pull and merge requests, with and without a
# task. origin is a local bare repo that git reaches through the GitHub URL.
test_pair_modes() {
  local origin=$T/origin.git wts=$T/repo/.claude/worktrees r=$T/repo
  git init -q --bare $origin
  git -C $r remote add origin https://github.com/acme/shop.git
  git -C $r config url."$origin".insteadOf https://github.com/acme/shop.git
  git -C $r push -q origin main
  local c=$(git -C $r commit-tree -p main -m "pr work" "main^{tree}")
  git -C $r push -q origin ${c}:refs/heads/feat/x ${c}:refs/pull/8/head ${c}:refs/heads/feat/y
  argv_of() {
    local agent=$(tmux list-panes -t "=demo:$1" -F '#{pane_id} #{pane_title}' | awk '/-claude$/ { print $1 }')
    within 5 eval "[[ -S \$(tmux display -p -t $agent '#{@agent_socket}') ]]" &&
      print -r -- $(tmux display -p -t $agent '#{@agent_socket}').argv
  }

  check "fleet pair --pr #7" fleet pair --pr '#7'
  eq "a same-repo PR checks out its branch" "$(git -C $wts/demo-pair-pr-7 symbolic-ref -q --short HEAD)" feat/x
  eq "tracking origin's" "$(git -C $wts/demo-pair-pr-7 rev-parse --abbrev-ref '@{upstream}')" origin/feat/x
  local a=$(argv_of pr-7-pair)
  check "the prompt names the PR" eval "grep -qF 'pull request #7, \"Add x\", https://github.com/acme/shop/pull/7' $a"
  check "and how to read its threads" eval "grep -qF 'gh pr view 7 --comments' $a"
  check "and to push only when asked" eval "grep -qF 'push only when the user asks' $a"

  check "fleet pair --pr owner/repo#8" fleet pair --pr 'acme/shop#8'
  eq "a fork's PR is detached at its head" "$(git -C $wts/demo-pair-pr-8 rev-parse HEAD)" $c
  check "and the prompt says pushing won't reach it" eval "grep -qF 'It is detached' $(argv_of pr-8-pair)"
  eq "a PR in a repo with no clone is refused" \
    "$(FLEET_REPO_DIRS=$T/none fleet pair --pr https://github.com/acme/other/pull/1 2>&1 | grep -o 'no local clone of github.com/acme/other')" \
    "no local clone of github.com/acme/other"

  check "fleet pair --pr !5" fleet pair --pr '!5'
  eq "an MR checks out its branch" "$(git -C $wts/demo-pair-pr-5 symbolic-ref -q --short HEAD)" feat/y
  check "the prompt names the MR and glab" eval "grep -qF 'merge request !5' $(argv_of pr-5-pair) && grep -qF 'glab mr view 5 --comments' $(argv_of pr-5-pair)"

  git -C $r branch newb main
  check "fleet pair --branch on a free branch" fleet pair --branch newb
  eq "it checks the branch out" "$(git -C $wts/demo-pair-newb symbolic-ref -q --short HEAD)" newb
  check "fleet pair --branch on a branch checked out elsewhere" fleet pair --branch main
  check "is detached there" test -z "$(git -C $wts/demo-pair-main symbolic-ref -q HEAD)"
  refuses "fleet pair --branch on a ref that doesn't exist" fleet pair --branch nope

  check "fleet pair --dir" fleet pair --dir $T/repo3
  check "it opens in the folder" within 3 eval "[[ \$(tmux display -p -t '=demo:repo3-pair.0' '#{pane_current_path}') == $T/repo3 ]]"
  check "and makes no worktree" test ! -e $T/repo3/.claude

  awk '{ print } /^ship:/ && !done { print "pr: https://github.com/acme/shop/pull/7"; done = 1 }' $(note beta) > $T/beta.md && mv $T/beta.md $(note beta)
  check "fleet pair <task> --pr uses the note's pr:" fleet pair beta --pr
  check "the prompt names the task and the PR" eval "grep -qF 'task beta of fleet demo' $(argv_of beta-pair) && grep -qF 'pull request #7' $(argv_of beta-pair)"

  for w in pr-7 pr-8 pr-5 newb main repo3 beta; do tmux kill-window -t "=demo:$w-pair"; done
  for w in pr-7 pr-8 pr-5 newb main beta; do git -C $r worktree remove --force $wts/demo-pair-$w; done
  git -C $r branch -q -D newb feat/x feat/y 2> /dev/null
  git -C $r remote remove origin
  git -C $r config --unset url."$origin".insteadOf
  sed -i.bak '/^pr: https:\/\/github.com\/acme\/shop\/pull\/7$/d' $(note beta) && rm $(note beta).bak
}

test_report() {
  refuses "a report from outside the worker's pane" fleet report alpha progress hi
  refuses "done with unchecked todos" as w1 command fleet report alpha done all done
  check "a progress report" as w1 command fleet report alpha progress halfway
  eq "the report sets the status" "$(field $(note alpha) status)" progress
  check "the report is logged in the note" has $(note alpha) '^- .* progress: halfway$'
  check "the orchestrator gets the report" within 3 received orch "Report: alpha progress: halfway"
  check "fleet status shows it" eval "fleet status | grep -E '^w1 .* alpha .* progress'"
}

test_todo_check() {
  local out
  out=$(print '{"stop_hook_active":false}' | as w1 $root/hooks/todo-check)
  eq "the first stop is blocked" "$(print -r -- $out | jq -r .decision)" block
  print '{"stop_hook_active":true}' | as w1 $root/hooks/todo-check > /dev/null
  eq "the second stop is stalled" "$(popt w1 @agent_state)" stalled
  check "the orchestrator gets a stall notice" within 3 received orch "Notice: alpha stalled"
  tmux set -p -t $(pane w1) @agent_state idle
}

test_diff() {
  print change > $(wt w1)/file.txt
  git -C $(wt w1) add file.txt
  git -C $(wt w1) commit -q -m "w1 work"
  check "a committed change shows in the task's diff" eval "fleet diff alpha --stat | grep -q file.txt"
  print more >> $(wt w1)/file.txt
  check "an uncommitted edit shows in the task's diff" eval "fleet diff alpha | grep -q '^+more'"
  git -C $(wt w1) commit -q -am "w1 more work"
  check "the branch diff shows it" eval "fleet diff w1 --stat | grep -q file.txt"
  check "the calling worker's branch, with no argument" eval "as w1 command fleet diff --stat | grep -q file.txt"
}

test_restart() {
  local old=$(sock w1)
  check "fleet restart" fleet restart w1
  eq "the seat keeps its task" "$(popt w1 @agent_task)" alpha
  check "the seat has a new socket" test $(sock w1) != $old
  check "the new session gets the task again" within 3 received w1 "Task alpha: your session restarted"
  check "the new session starts in the worktree" within 3 eval "[[ \$(popt w1 pane_current_path) == $(wt w1) ]]"
}

# the stub never runs SessionEnd, so these run the hook as Claude Code would
test_session_end() {
  local s=$(sock w1) w1=$(pane w1)
  tmux set -p -t $w1 @agent_state restarting
  print '{"reason":"other"}' | as w1 $root/hooks/session-end
  tmux set -t '=demo:' @fleet_stopping 1
  tmux set -p -t $w1 @agent_socket $s
  print '{"reason":"other"}' | as w1 $root/hooks/session-end
  tmux set -u -t '=demo:' @fleet_stopping
  tmux set -p -t $w1 @agent_socket $s
  print '{"reason":"prompt_input_exit"}' | as w1 $root/hooks/session-end
  check "the orchestrator gets a session-ended notice" within 3 received orch "Notice: alpha: the worker's session ended (prompt_input_exit)"
  eq "only that end sends a notice, not a restart or a kill" "$(messages orch | grep -c 'session ended')" 1
  eq "the seat's socket is unset" "$(popt w1 @agent_socket)" ""
  eq "the seat's state is unset" "$(popt w1 @agent_state)" ""
  # the stub is still running; give the pane back what the hook unset
  tmux set -p -t $w1 @agent_socket $s
  tmux set -p -t $w1 @agent_state idle
}

test_clear() {
  todos alpha '[x] one' '[x] two'
  check "a done report" as w1 command fleet report alpha done finished
  local head=$(git -C $(wt w1) rev-parse HEAD)
  # work left uncommitted: an edit, a new file, and a big untracked folder
  print edited >> $(wt w1)/file.txt
  print page > $(wt w1)/page.html
  mkdir -p $(wt w1)/deps && for i in {1..101}; do : > $(wt w1)/deps/f$i; done
  check "fleet clear" fleet clear w1
  local saved=$(git -C $T/repo rev-parse -q --verify refs/fleet/demo/alpha)
  check "the uncommitted work is saved to refs/fleet/demo/alpha" test -n "$saved"
  eq "the note records the ref" "$(field $(note alpha) wip)" "refs/fleet/demo/alpha $saved"
  eq "the saved commit sits on the task's end" "$(git -C $T/repo rev-parse "$saved^")" $head
  eq "it holds the new file" "$(git -C $T/repo show $saved:page.html)" page
  check "it holds the edit" eval "git -C $T/repo show $saved:file.txt | grep -qx edited"
  check "it leaves the big folder out" eval "! git -C $T/repo cat-file -e $saved:deps 2> /dev/null"
  eq "the worktree is back at its last commit, but for the folder" "$(git -C $(wt w1) status --porcelain)" "?? deps/"
  check "the Log lists the saved files and the folder left in place" has $(note alpha) 'clear: saved uncommitted work to refs/fleet/demo/alpha .*file\.txt, page\.html; left untracked in place: deps/ \(101 files\)'
  rm -r $(wt w1)/deps
  eq "the note records the end" "$(field $(note alpha) end)" $head
  eq "the note records the close date" "$(field $(note alpha) closed)" $(date +%F)
  eq "the seat drops the task" "$(popt w1 @agent_task)" ""
  check "/clear is typed into the seat" within 3 grep -qx /clear $(typed w1)
  check "the seat registers again" within 5 eval "[[ \$(popt w1 @agent_state) == idle ]]"
}

# a pair on a closed task with saved work gets it back as uncommitted changes
test_pair_wip() {
  check "fleet pair on alpha" fleet pair alpha
  local d=$T/repo/.claude/worktrees/demo-pair-alpha
  eq "the saved work is uncommitted in the pair checkout" "$(git -C $d status --porcelain | sort | xargs)" "M file.txt ?? page.html"
  local agent=$(tmux list-panes -t '=demo:alpha-pair' -F '#{pane_id} #{pane_title}' | awk '$2 == "demo-alpha-claude" { print $1 }')
  check "the prompt says so" within 5 eval "grep -qF 'saved in refs/fleet/demo/alpha, is applied here' \$(tmux display -p -t $agent '#{@agent_socket}').argv"
  tmux kill-window -t '=demo:alpha-pair'
  git -C $T/repo worktree remove --force $d
}

test_follow_up() {
  check "a follow-up to a closed task" fleet task gamma --from alpha
  eq "the follow-up records what it follows" "$(field $(note gamma) follows)" alpha
  check "the follow-up links its source" has $(note gamma) '\[alpha\]\(alpha\.md\)'
  # w1's branch has commits of its own, so moving main makes assign merge
  git -C $T/repo commit -q --allow-empty -m "main moves again"
  check "the follow-up goes to the same worker" fleet assign w1 gamma
  eq "the sync merge's message names no worker" "$(git -C $(wt w1) log -1 --format=%s)" "Merge branch 'main'"
}

test_abandon() {
  check "fleet assign w2" fleet assign w2 beta
  tmux set -p -t $(pane w2) @agent_state question
  check "fleet abandon from state question" fleet abandon w2
  eq "the note is abandoned" "$(field $(note beta) status)" abandoned
  eq "the note records the end" "$(field $(note beta) end)" $(git -C $(wt w2) rev-parse HEAD)
  check "the note logs it" has $(note beta) '^- .* abandoned: '
  eq "the seat drops the task" "$(popt w2 @agent_task)" ""
  # the stub reads the Escape that abandon types first as part of the line
  check "/clear is typed into the seat" within 3 grep -q '/clear$' $(typed w2)
  refuses "abandon on a seat with no task" fleet abandon w2
}

test_archive() {
  local n=$T/agents/demo
  # alpha closed last month, beta this month; gamma is open, follows alpha, and so
  # keeps it in tasks/ until it closes
  local last=$(date -v-1m +%Y-%m 2> /dev/null || date -d '-1 month' +%Y-%m)
  sed -i.bak "s/^closed: .*/closed: $last-15/" $(note alpha) && rm $(note alpha).bak
  print -- "- [alpha](tasks/alpha.md) and [beta](tasks/beta.md)" >> $n/backlog.md
  print -- "See [alpha](alpha.md) and the [brief](../brief.md), and [this month](archive/$(date +%Y-%m))." >> $(note beta)
  eq "an open follow-up keeps its source" "$(fleet archive --dry-run | tail -n +2)" beta
  check "fleet archive" fleet archive
  local a2=$n/tasks/archive/$(date +%Y-%m)/beta.md
  check "beta moves into this month" test -f $a2
  check "beta's link to alpha, still open, goes up two folders" has $a2 '\[alpha\]\(\.\./\.\./alpha\.md\)'
  check "beta's link to the brief goes up three" has $a2 '\[brief\]\(\.\./\.\./\.\./brief\.md\)'
  check "beta's link to its own new folder keeps the folder's name" has $a2 "\[this month\]\(\.\./$(date +%Y-%m)\)"
  check "the backlog follows beta" has $n/backlog.md "\(tasks/archive/$(date +%Y-%m)/beta\.md\)"

  check "fleet clear w1 closes gamma" fleet clear w1
  eq "alpha and gamma go together, since gamma is alpha's only holder" "$(fleet archive --dry-run | tail -n +2 | sort | xargs)" "alpha gamma"
  check "fleet archive after gamma closes" fleet archive
  local a1=$n/tasks/archive/$last/alpha.md
  check "alpha moves into last month" test -f $a1
  check "beta's link follows alpha into last month" has $a2 "\[alpha\]\(\.\./$last/alpha\.md\)"
  check "the backlog follows alpha" has $n/backlog.md "\(tasks/archive/$last/alpha\.md\)"
  check "gamma's link follows alpha across months" has $n/tasks/archive/$(date +%Y-%m)/gamma.md "\[alpha\]\(\.\./$last/alpha\.md\)"
  check "the moves are committed as renames" eval "git -C $n show --stat -M HEAD | grep -q '=>'"
}

test_review() {
  local n=$(note delta)
  fleet task delta a plan > /dev/null
  sed -i.bak 's/^approve: no$/approve: yes/' $n && rm $n.bak
  todos delta '[x] research'
  awk '{ print } $0 == "## Questions" { print ""; print "- [ ] Q1 (Kevin): which way?"; print "  - [ ] left"; print "  - [ ] right" }' $n > $T/q.md && mv $T/q.md $n
  # the stub reads abandon's Escape and /clear as one line and keeps the
  # state test_abandon left; a real session starts again idle
  tmux set -p -t $(pane w2) @agent_state idle
  check "fleet assign w2 delta" fleet assign w2 delta
  refuses "done on an approve: yes task before review" as w2 command fleet report delta done finished
  check "a review report" as w2 command fleet report delta review plan ready
  eq "the note is in review" "$(field $n status)" review
  check "the orchestrator gets the review" within 3 received orch "Report: delta review: plan ready"
  eq "the note asks for approval" "$(grep -c '^- \[ \] Approve:' $n)" 1
  check "the worker's question stays, ahead of the approval" eval "awk '/^- \\[ \\] Q1/ { q = NR } /^- \\[ \\] Approve:/ { a = NR } END { exit !(q && a > q) }' $n"
  check "a second review" as w2 command fleet report delta review plan revised
  eq "a second review asks once" "$(grep -c 'Approve:' $n)" 1
  print '{"stop_hook_active":false}' | as w2 $root/hooks/todo-check > /dev/null
  eq "the seat waits on a question" "$(popt w2 @agent_state)" question
  refuses "done with open questions" as w2 command fleet report delta done finished
  tmux set -p -t $(pane w2) @agent_state idle
  eq "clear refuses a task with open questions" "$(fleet clear w2 2>&1)" "fleet: delta has 2 open questions; wait for the answers, or fleet abandon w2 to close it"
  tmux set -p -t $(pane w2) @agent_state question
  sed -i.bak -e 's/^- \[ \] Q1/- [x] Q1/' -e 's/^  - \[ \] left/  - [x] left/' \
    -e 's/^- \[ \] Approve:/- [x] Approve:/' -e 's/^  - \[ \] approve$/  - [x] approve/' $n && rm $n.bak
  check "fleet answer after approval" fleet answer delta
  check "w2 gets the answers" within 3 received w2 "Questions in delta are answered"
  check "done once approved" as w2 command fleet report delta done approved
  tmux set -p -t $(pane w2) @agent_state idle
  check "fleet clear after approval" fleet clear w2
}

# :FleetFollowUp and :FleetAssign in a headless nvim on delta, which w2 closed
nv() {
  local note=$1
  shift
  local lua=$T/nv.lua cmd
  : > $lua
  for cmd in "$@"; do print -r -- "vim.cmd([[$cmd]])" >> $lua; done
  print -r -- "vim.wait(2000, function() return false end)" >> $lua
  $real_nvim --clean --headless --cmd "set rtp+=$root/nvim" --cmd 'runtime plugin/fleet.lua' \
    -c "edit $note" -c "luafile $lua" -c 'qa!' > /dev/null 2>&1
}

test_nvim_follow_up() {
  nv $(note delta) FleetFollowUp
  check "FleetFollowUp creates delta-2" test -f $(note delta-2)
  nv $(note delta) FleetFollowUp
  check "a second FleetFollowUp opens delta-2 again" test ! -e $(note delta-3)
  nv $(note delta-2) FleetAssign
  eq "FleetAssign refuses a blank Todo" "$(field $(note delta-2) worker)" ""
  todos delta-2 '[ ] the follow-up work'
  nv $(note delta-2) FleetAssign
  eq "FleetAssign picks delta's seat" "$(popt w2 @agent_task)" delta-2
  check "w2 gets the task" within 3 received w2 "Task delta-2: read $(note delta-2)"
  todos delta-2 '[x] the follow-up work'
  tmux set -p -t $(pane w2) @agent_state idle
  fleet clear w2 > /dev/null
  nv $(note delta) FleetFollowUp
  check "a taken follow-up doesn't block a new one" test -f $(note delta-3)
  rm $(note delta-3)
}

# a task in the fleet's second repo: its own worktree, base, diff, close and pair
test_multi_repo() {
  local r2=$T/repo2 wt2=$T/repo2/.claude/worktrees/demo-w2
  refuses "a task in a repo the fleet doesn't have" fleet task multi-zero --repo $T/repo3 nope
  check "fleet repo add" fleet repo add $T/repo3
  eq "fleet repo lists all three" "$(fleet repo | wc -l | tr -d ' ')" 3
  check "seats get --add-dir for the added repo" eval "[[ \$(popt w1 @agent_cmd) == *'--add-dir $T/repo3 '* ]]"
  check "fleet task --repo" fleet task multi-one --repo $r2 change the second repo
  eq "the note records its repo" "$(field $(note multi-one) repo)" $r2
  todos multi-one '[ ] change it'
  tmux set -p -t $(pane w2) @agent_state idle
  check "fleet assign in the second repo" fleet assign w2 multi-one
  check "w2 gets a worktree there" test -d $wt2
  eq "on the seat's branch" "$(git -C $wt2 symbolic-ref -q --short HEAD)" worktree-demo-w2
  eq "base is the second repo's main" "$(field $(note multi-one) base)" "$(git -C $r2 rev-parse main)"
  check "the message names the worktree" within 3 received w2 "It works in $r2, in your worktree $wt2."
  eq "fleet path follows the task's repo" "$(fleet path w2)" $wt2
  print two > $wt2/two.txt && git -C $wt2 add two.txt && git -C $wt2 commit -q -m "add two"
  check "fleet diff shows the second repo's change" eval "fleet diff multi-one --stat | grep -q two.txt"
  print left > $wt2/left.txt
  todos multi-one '[x] change it'
  check "a done report" as w2 command fleet report multi-one done changed
  tmux set -p -t $(pane w2) @agent_state idle
  check "fleet clear" fleet clear w2
  eq "end is the second repo's commit" "$(field $(note multi-one) end)" "$(git -C $wt2 rev-parse HEAD)"
  check "the uncommitted file is saved in the second repo" eval "git -C $r2 cat-file -e refs/fleet/demo/multi-one:left.txt"
  check "a follow-up" fleet task multi-two --from multi-one
  eq "the follow-up works in the same repo" "$(field $(note multi-two) repo)" $r2
  check "fleet pair on multi-one" fleet pair multi-one
  check "its pair worktree is in the second repo" test -d $r2/.claude/worktrees/demo-pair-multi-one
  tmux kill-window -t '=demo:multi-one-pair'
  git -C $r2 worktree remove --force $r2/.claude/worktrees/demo-pair-multi-one
  rm $(note multi-two)
}

test_migrate() {
  local f=$T/agents/demo/tasks/old.md
  printf '# old: an old note\n\nFleet: demo\nTask: old\nStatus: done\n\n## Todo\n\n- [x] a\n' > $f
  eq "migrate lists the old note" "$(fleet migrate --dry-run | tail -n +2)" old
  check "fleet migrate" fleet migrate
  check "the note has frontmatter" eval "[[ \$(head -1 $f) == --- ]]"
  eq "the status carries over" "$(field $f status)" done
}

test_kill() {
  check "fleet kill" fleet kill
  check "the session is gone" within 3 eval "! tmux has-session -t '=demo:'"
  eq "fleet ls shows it stopped" "$(command fleet ls | awk '$1 == "demo" { print $2 }')" stopped
}

test_clean() {
  check "fleet clean --branches" eval "command fleet clean demo --branches > $T/clean.log 2>&1"
  check "git's branch deletion shows" has $T/clean.log '^Deleted branch demo-w2' 
  check "w2's worktree is removed" test ! -d $(wt w2)
  check "w1's worktree is removed" test ! -d $(wt w1)
  check "w2's worktree in the second repo is removed" test ! -d $T/repo2/.claude/worktrees/demo-w2
  eq "w2's branch, merged into main, is deleted" "$(git -C $T/repo branch --list demo-w2)" ""
  check "w1's branch, with unmerged work, stays" eval "git -C $T/repo branch --list demo-w1 | grep -q demo-w1"
  check "the state folder is removed" test ! -d $T/state/fleet/demo
  check "the notes stay" test -d $T/agents/demo/.git
  eq "fleet ls shows only the notes" "$(command fleet ls | awk '$1 == "demo" { print $2 }')" notes
}

