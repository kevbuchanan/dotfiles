#!/bin/sh
# Starts prose detached from the calling shell, so it outlives Claude Code's
# background-task time limit and the editor or shell that started it. One
# server per port; the pid, log and served file live in
# ~/.local/state/prose/<port>.{pid,log,file}.
#
#   prose-bg <file> [--port N] [--no-open] [--socket PATH | --to NAME | --here]
#   prose-bg --stop <port>
#   prose-bg --list
#
# Comments go to the session inbox socket given by --socket, by --to (a
# running session's name), or by --here (the Claude session in this tmux
# window). With none of those the server posts to the calling session's own
# socket, $CLAUDE_CODE_MESSAGING_SOCKET, if there is one. Without --port the
# server takes the first free port from 4917.
set -eu
here=$(cd "$(dirname "$(realpath "$0")")" && pwd)
state="${XDG_STATE_HOME:-$HOME/.local/state}/prose"
mkdir -p "$state"

alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

case "${1:-}" in
  --stop)
    # no default port: servers take ports in order, so a default would stop
    # whichever server happens to hold 4917
    port="${2:?usage: prose-bg --stop <port>}"
    pidfile="$state/$port.pid"
    if alive "$pidfile"; then
      kill "$(cat "$pidfile")"
      echo "stopped prose on port $port"
    else
      echo "no prose running on port $port"
    fi
    rm -f "$pidfile" "$state/$port.file"
    exit 0
    ;;
  --list)
    for pidfile in "$state"/*.pid; do
      alive "$pidfile" || continue
      port=$(basename "$pidfile" .pid)
      printf '%s\t%s\t%s\n' "$port" "$(cat "$pidfile")" "$(cat "$state/$port.file" 2>/dev/null || echo -)"
    done
    exit 0
    ;;
esac

# Rebuild the argument list, turning --to and --here into --socket.
port=""
file=""
n=$#
i=0
while [ $i -lt $n ]; do
  a="$1"
  shift
  i=$((i + 1))
  case "$a" in
    -p|--port) port="$1"; shift; i=$((i + 1)); set -- "$@" --port "$port" ;;
    --port=*) port="${a#--port=}"; set -- "$@" --port "$port" ;;
    --socket) set -- "$@" --socket "$1"; shift; i=$((i + 1)) ;;
    --to)
      sock=$("$here/prose-session" --name "$1") || exit 1
      shift
      i=$((i + 1))
      set -- "$@" --socket "$sock"
      ;;
    --here)
      sock=$("$here/prose-session" --window) || exit 1
      set -- "$@" --socket "$sock"
      ;;
    -*) set -- "$@" "$a" ;;
    *) file="$a"; set -- "$@" "$a" ;;
  esac
done

if [ -z "$port" ]; then
  port=4917
  while alive "$state/$port.pid" || nc -z localhost "$port" 2>/dev/null; do
    port=$((port + 1))
  done
  set -- "$@" --port "$port"
fi
pidfile="$state/$port.pid"
log="$state/$port.log"

if alive "$pidfile"; then
  echo "prose already running on port $port (pid $(cat "$pidfile")); run prose-bg --stop $port first" >&2
  exit 1
fi

# setsid puts the server in its own session, so the harness killing the
# calling shell's process group does not take the server with it.
nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die "exec: $!"' \
  "$here/prose" "$@" </dev/null >"$log" 2>&1 &
echo $! >"$pidfile"
[ -n "$file" ] && realpath "$file" >"$state/$port.file" 2>/dev/null || true

# The server prints "Listening on" once the port is bound. It exits instead
# when the port is taken or the file is missing.
i=0
while [ $i -lt 150 ]; do
  if grep -q "Listening on" "$log" 2>/dev/null; then
    cat "$log"
    echo "pid $(cat "$pidfile"), log $log"
    exit 0
  fi
  if ! alive "$pidfile"; then
    cat "$log" >&2
    rm -f "$pidfile" "$state/$port.file"
    exit 1
  fi
  sleep 0.1
  i=$((i + 1))
done
echo "prose did not report listening within 15s; see $log" >&2
exit 1
