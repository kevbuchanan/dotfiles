#!/bin/sh
# prose: a live markdown review page whose comments go to a Claude Code
# session. One entrypoint; each subcommand runs a bin/prose-<command> script.
#
#   prose start <file> [--to NAME | --new] [--no-open] [--port N]
#                               open a review and pick its session
#   prose serve <file> [--bg] [--port N] [--no-open] [--socket P | --to NAME | --here]
#                               run the server; --bg detaches it
#   prose stop <port|file>      stop a server
#   prose ls                    port, pid and file of each running server
#   prose respond <file|port> <phase> [ids...] [--text T | --text-file F] [--work W]
#                               post an agent reply to a page
#   prose pending <file|port>   unfinished requests, one JSON object per line
#   prose post <port> [--get]   post one raw activity event, or print history
#   prose port <file|port>      the port of a file's server
#   prose join <file|port>      point a server at the calling Claude session
#   prose sessions [--name N | --window [PANE] | --list]
#                               find running Claude Code sessions
set -eu
here=$(cd "$(dirname "$(realpath "$0")")" && pwd)

usage() { sed -n '2,/^set/s/^# \{0,1\}//p' "$0" | sed '$d'; }

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  start) exec "$here/prose-start" "$@" ;;
  serve)
    # --bg anywhere in the arguments picks the detached runner
    bg=0
    n=$#
    i=0
    while [ $i -lt $n ]; do
      a="$1"
      shift
      i=$((i + 1))
      if [ "$a" = --bg ]; then bg=1; else set -- "$@" "$a"; fi
    done
    if [ $bg -eq 1 ]; then exec "$here/prose-bg" "$@"; fi
    exec "$here/prose-serve" "$@"
    ;;
  stop) exec "$here/prose-bg" --stop "$("$here/prose-port" "${1:?usage: prose stop <port|file>}")" ;;
  ls) exec "$here/prose-bg" --list ;;
  respond | pending | post | port | join) exec "$here/prose-$cmd" "$@" ;;
  sessions) exec "$here/prose-session" "$@" ;;
  help | -h | --help) usage ;;
  *) echo "prose: unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
